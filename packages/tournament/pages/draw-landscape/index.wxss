.landscape-page{
  width:100vw;
  height:100vh;
  display:flex;
  flex-direction:column;
  overflow:hidden;
  background:var(--canvas);
  color:var(--ink);
}
.landscape-toolbar{
  flex:none;
  min-height:132rpx;
  padding-left:18rpx;
  padding-bottom:12rpx;
  display:grid;
  grid-template-columns:auto minmax(180rpx,1fr) auto;
  grid-template-areas:
    "back title zoom"
    "search search actions";
  align-items:center;
  gap:10rpx 14rpx;
  border-bottom:1rpx solid var(--line);
  background:var(--surface);
  box-sizing:border-box;
}
.landscape-toolbar button{
  min-height:48rpx;
  margin:0;
  padding:0 14rpx;
  display:flex;
  align-items:center;
  justify-content:center;
  border:1rpx solid var(--line);
  border-radius:12rpx;
  background:var(--surface-subtle);
  color:var(--brand-strong);
  font-size:20rpx;
  line-height:1.2;
  white-space:nowrap;
}
.landscape-toolbar button::after{
  border:0;
}
.exit-button{
  grid-area:back;
}
.toolbar-title{
  grid-area:title;
  min-width:160rpx;
  display:flex;
  flex-direction:column;
  gap:2rpx;
}
.toolbar-title text:first-child{
  overflow:hidden;
  color:var(--ink);
  font-size:26rpx;
  font-weight:800;
  text-overflow:ellipsis;
  white-space:nowrap;
}
.toolbar-title text:last-child{
  color:var(--brand-strong);
  font-size:20rpx;
  font-weight:700;
}
.zoom-actions{
  grid-area:zoom;
  display:flex;
  gap:6rpx;
}
.zoom-actions button{
  width:50rpx;
  padding:0;
  font-size:24rpx;
  font-weight:800;
}
.toolbar-search{
  grid-area:search;
  min-width:180rpx;
  height:52rpx;
  padding:0 14rpx;
  display:flex;
  align-items:center;
  gap:7rpx;
  border:1rpx solid var(--line);
  border-radius:12rpx;
  background:var(--surface-subtle);
  box-sizing:border-box;
}
.toolbar-search input{
  min-width:0;
  height:50rpx;
  flex:1;
  color:var(--ink);
  font-size:21rpx;
}
.toolbar-actions{
  grid-area:actions;
  display:flex;
  gap:6rpx;
  overflow:hidden;
}
.landscape-state{
  flex:1;
  padding:80rpx 32rpx;
  box-sizing:border-box;
}
.landscape-board{
  flex:1;
  width:100vw;
  height:auto;
  background-color:var(--canvas);
  background-image:linear-gradient(var(--line) 1rpx, transparent 1rpx),linear-gradient(90deg,var(--line) 1rpx,transparent 1rpx);
  background-size:44rpx 44rpx;
}
.bracket-board{
  min-width:1440rpx;
  min-height:680rpx;
  padding:22rpx 36rpx 96rpx;
  display:inline-flex;
  gap:72rpx;
  align-items:flex-start;
  transition:transform .16s ease;
  box-sizing:border-box;
}
.bracket-board.overview{
  opacity:.92;
}
.bracket-column{
  width:456rpx;
  flex:0 0 456rpx;
}
.round-title{
  position:sticky;
  top:0;
  z-index:3;
  height:52rpx;
  padding:11rpx 14rpx;
  display:block;
  border-radius:12rpx;
  background:var(--brand-soft);
  color:var(--brand-strong);
  font-size:23rpx;
  font-weight:800;
  box-sizing:border-box;
}
.selected-round .round-title{
  background:var(--brand);
  color:#fff;
}
.round-body{
  position:relative;
  margin-top:10rpx;
  width:456rpx;
}
.bracket-node{
  position:absolute;
  left:0;
  width:456rpx;
  height:168rpx;
  min-height:168rpx;
  margin:0;
  padding:12rpx 16rpx;
  overflow:visible;
  border:1rpx solid var(--line);
  border-radius:16rpx;
  background:var(--surface);
  box-shadow:0 10rpx 26rpx rgba(21,55,96,.08);
  text-align:left;
  box-sizing:border-box;
}
.bracket-node::after{
  content:'';
  position:absolute;
  right:-72rpx;
  top:50%;
  width:72rpx;
  height:2rpx;
  background:var(--line-strong);
}
.bracket-column:last-child .bracket-node::after{
  display:none;
}
.bracket-node::after,
.connector-in,
.connector-in::after{
  background:var(--line-strong);
}
.connector-in{
  position:absolute;
  left:-36rpx;
  width:2rpx;
}
.connector-in::after{
  content:'';
  position:absolute;
  left:0;
  top:50%;
  width:36rpx;
  height:2rpx;
}
.node-side{
  position:relative;
  min-height:58rpx;
  display:grid;
  grid-template-columns:38rpx minmax(0,1fr) auto;
  align-items:center;
  gap:10rpx;
  border-bottom:1rpx solid var(--surface-subtle);
}
.node-side.winner::before{
  content:'';
  position:absolute;
  left:-9rpx;
  top:7rpx;
  bottom:7rpx;
  width:4rpx;
  border-radius:0 5rpx 5rpx 0;
  background:var(--brand);
}
.node-members{
  min-width:0;
  display:flex;
  flex-direction:column;
  gap:2rpx;
  overflow:hidden;
}
.node-name{
  min-width:0;
  max-width:100%;
  overflow:hidden;
  color:var(--ink);
  font-size:23rpx;
  line-height:1.22;
  font-weight:720;
  text-overflow:ellipsis;
  white-space:nowrap;
  word-break:keep-all;
}
.node-side.winner .node-name{
  color:var(--ink-strong);
  font-weight:850;
}
.seed,
.entry{
  color:var(--ink-subtle);
  font-size:17rpx;
}
.seed-slot{
  min-width:34rpx;
  text-align:center;
}
.node-scores{
  display:flex;
  align-items:center;
  justify-content:flex-end;
  gap:4rpx;
}
.node-scores>text{
  position:relative;
  min-width:28rpx;
  color:var(--ink);
  font-size:22rpx;
  font-weight:800;
  text-align:right;
}
.tiebreak{
  position:absolute;
  right:-2rpx;
  top:-10rpx;
  color:var(--ink-subtle);
  font-size:11rpx;
}
.node-foot{
  min-height:34rpx;
  padding-top:7rpx;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:12rpx;
}
.node-foot text{
  overflow:hidden;
  color:var(--ink-subtle);
  font-size:17rpx;
  text-overflow:ellipsis;
  white-space:nowrap;
}
.champion-node{
  border-color:var(--brand);
  background:linear-gradient(135deg,var(--brand-wash),var(--surface));
}
.champion-line{
  min-height:112rpx;
  display:grid;
  grid-template-columns:38rpx minmax(0,1fr) auto;
  align-items:center;
  gap:6rpx;
}
.champion-line .node-name{
  color:var(--ink-strong);
  font-size:25rpx;
  font-weight:880;
}
.node-status{
  color:var(--brand-strong);
  font-size:19rpx;
  font-weight:800;
}
.path-node{
  border-color:var(--brand);
  box-shadow:0 0 0 3rpx var(--brand-soft),0 10rpx 26rpx rgba(21,55,96,.08);
}
.mini-map{
  position:fixed;
  right:18rpx;
  bottom:18rpx;
  z-index:4;
  width:168rpx;
  height:104rpx;
  border:1rpx solid var(--line);
  border-radius:18rpx;
  background:rgba(255,255,255,.88);
  box-shadow:0 10rpx 26rpx rgba(21,55,96,.12);
}
.mini-map::before{
  content:'';
  position:absolute;
  left:18rpx;
  right:18rpx;
  top:18rpx;
  bottom:18rpx;
  background:repeating-linear-gradient(90deg,var(--line),var(--line) 1rpx,transparent 1rpx,transparent 24rpx);
}
.mini-map>view{
  position:absolute;
  left:0;
  top:0;
  width:48rpx;
  height:34rpx;
  border:3rpx solid var(--brand);
  border-radius:8rpx;
  box-sizing:border-box;
}
.theme-dark .mini-map{
  background:rgba(21,33,53,.9);
}
.theme-daylight .landscape-page{
  background:#f5f1e6;
}
.theme-daylight .landscape-toolbar,
.theme-daylight .bracket-node{
  border-color:#d8d5c8;
  background:#fffdf7;
}
.theme-daylight .landscape-board{
  background-color:#edf0e5;
}
.theme-daylight .round-title,
.theme-daylight .landscape-toolbar button{
  background:#e6eee3;
  color:#54775e;
}
.theme-daylight .selected-round .round-title,
.theme-daylight .node-side.winner::before{
  background:#54775e;
  color:#fff;
}
