.daylight-h2h-panel {
  width: 100%;
  box-sizing: border-box;
  overflow-x: hidden;
}

.daylight-h2h-inputs.h2h-inputs {
  width: 100%;
  padding: 18rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  align-items: stretch;
  box-sizing: border-box;
}

.daylight-h2h-inputs.h2h-inputs > .h2h-search-field {
  width: 100%;
  height: auto;
  min-width: 0;
  border-bottom: 0;
  box-sizing: border-box;
}

.daylight-h2h-inputs.h2h-inputs .h2h-input-box {
  height: 68rpx;
  border: 1rpx solid #d8d5c8;
  border-radius: 12rpx;
  background: #fffdf7;
}

.daylight-h2h-inputs.h2h-inputs input {
  height: 68rpx;
  text-align: left;
}

.daylight-h2h-inputs.h2h-inputs > .h2h-vs {
  height: 28rpx;
  border-bottom: 0;
  color: #d88b62;
  font-family: Georgia, serif;
  line-height: 28rpx;
  text-align: center;
}

.daylight-h2h-inputs.h2h-inputs > .h2h-submit {
  width: 100%;
  min-height: 70rpx;
  margin-top: 0;
  border-radius: 12rpx;
  background: #54775e;
  color: #fff;
  font-size: 21rpx;
  box-sizing: border-box;
}

.theme-daylight .h2h-options {
  border-color: #d8d5c8;
  background: #fffdf7;
}

.theme-daylight .h2h-option {
  border-bottom-color: #ece8dd;
}

.theme-daylight .h2h-option-name {
  color: #233028;
}

.theme-daylight .h2h-option-meta,
.theme-daylight .h2h-search-hint {
  color: #8b8b7e;
}

.h2h-match-row {
  grid-template-columns: minmax(0, 1fr);
  gap: 8rpx;
}

.h2h-match-main,
.h2h-match-outcome {
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.h2h-match-main {
  justify-content: flex-start;
}

.h2h-match-outcome {
  justify-content: space-between;
}

.h2h-match-meta {
  color: var(--ink-subtle);
  font-size: 19rpx;
}

.h2h-match-winner {
  color: var(--ink);
  font-weight: 700;
}

.h2h-match-result {
  margin-left: auto;
}

.daylight-h2h-history > .daylight-h2h-match-row {
  min-height: auto;
  padding: 14rpx 0;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  justify-content: flex-start;
  gap: 6rpx;
}

.daylight-h2h-match-main,
.daylight-h2h-match-outcome {
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.daylight-h2h-match-main text,
.daylight-h2h-match-outcome text,
.daylight-h2h-match-meta {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.daylight-h2h-match-main text:first-child {
  flex: none;
  color: #8b8b7e;
  font-size: 16rpx;
}

.daylight-h2h-match-main text:last-child {
  min-width: 0;
  color: #233028;
  font-size: 19rpx;
  font-weight: 700;
}

.daylight-h2h-match-meta {
  color: #748078;
  font-size: 17rpx;
}

.daylight-h2h-match-outcome {
  justify-content: space-between;
}

.daylight-h2h-match-winner {
  color: #233028;
  font-size: 18rpx;
  font-weight: 700;
}

.daylight-h2h-match-score {
  margin-left: auto;
  color: #54775e;
  font-size: 18rpx;
  font-weight: 700;
}

.follow-tabs {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.follow-leaderboard-list {
  width: 100%;
  max-width: 100%;
  padding: 16rpx 20rpx 42rpx;
  box-sizing: border-box;
  overflow-x: hidden;
}

.leaderboard-card {
  width: 100%;
  max-width: 100%;
  min-height: 190rpx;
  margin-bottom: 14rpx;
  padding: 14rpx 16rpx;
  display: flex;
  align-items: stretch;
  gap: 14rpx;
  border: 1rpx solid var(--line);
  border-radius: 16rpx;
  background: var(--surface);
  box-shadow: 0 10rpx 26rpx rgba(22, 62, 101, .07);
  box-sizing: border-box;
}

.leaderboard-rank {
  width: 48rpx;
  height: 48rpx;
  flex: 0 0 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  background: var(--brand-strong);
  color: #fff;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 48rpx;
}

.leaderboard-photo {
  width: 142rpx;
  min-height: 162rpx;
  flex: 0 0 142rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border-radius: 14rpx;
  background: var(--surface-subtle);
}

.leaderboard-photo image {
  width: 100%;
  height: 100%;
}

.leaderboard-copy {
  min-width: 0;
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.leaderboard-name-row {
  min-width: 0;
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
}

.leaderboard-name-row > view:first-child {
  min-width: 0;
  flex: 1;
  display: flex;
  flex-direction: column;
}

.leaderboard-name {
  max-width: 100%;
  overflow: hidden;
  color: var(--ink-strong);
  font-size: 29rpx;
  font-weight: 820;
  line-height: 36rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.leaderboard-original {
  max-width: 100%;
  overflow: hidden;
  color: var(--ink-subtle);
  font-size: 21rpx;
  line-height: 28rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.leaderboard-meta {
  min-width: 0;
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx 12rpx;
  color: var(--ink-muted);
  font-size: 20rpx;
  line-height: 26rpx;
}

.leaderboard-meta text {
  max-width: 100%;
}

.leaderboard-follow-count {
  margin-top: auto;
  color: var(--ink-strong);
  font-size: 24rpx;
  font-weight: 760;
  line-height: 32rpx;
}

.daylight-follow-leaderboard-list {
  background: #f5f1e6;
}

.daylight-leaderboard-card {
  border-color: #d8d5c8;
  background: #fffdf7;
  box-shadow: 0 14rpx 28rpx rgba(60, 70, 48, .08);
}

.daylight-leaderboard-card .leaderboard-rank {
  background: #54775e;
}

.daylight-leaderboard-card .leaderboard-name {
  color: #233028;
  font-family: "Songti SC", STSong, Georgia, serif;
}

.daylight-leaderboard-card .leaderboard-original {
  color: #5f6d62;
}

.daylight-leaderboard-card .leaderboard-meta {
  color: #8b8b7e;
}

.daylight-leaderboard-card .leaderboard-follow-count {
  color: #233028;
}

.daylight-leaderboard-card .leaderboard-photo {
  background: #f8ead9;
}

@media (max-width: 350px) {
  .follow-leaderboard-list {
    padding-right: 12rpx;
    padding-left: 12rpx;
  }

  .leaderboard-card {
    gap: 10rpx;
    padding-right: 10rpx;
    padding-left: 10rpx;
  }

  .leaderboard-rank {
    width: 40rpx;
    height: 40rpx;
    flex-basis: 40rpx;
    font-size: 22rpx;
    line-height: 40rpx;
  }

  .leaderboard-photo {
    width: 116rpx;
    flex-basis: 116rpx;
  }

  .leaderboard-name {
    font-size: 25rpx;
  }

  .leaderboard-original,
  .leaderboard-meta {
    font-size: 18rpx;
  }
}
