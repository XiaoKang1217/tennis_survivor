.players-page {
  min-height: 100vh;
  padding-bottom: calc(138rpx + env(safe-area-inset-bottom));
  background: var(--canvas);
}

.module-head {
  min-height: 108rpx;
  padding-left: 20rpx;
  padding-right: 20rpx;
  display: grid;
  grid-template-columns: 88rpx 1fr 88rpx;
  align-items: center;
  background: var(--surface);
  box-sizing: content-box;
}

.module-head > view:nth-child(2) {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.eyebrow {
  color: var(--ink-subtle);
  font-size: 21rpx;
}

.title {
  color: var(--ink);
  font-size: 32rpx;
  font-weight: 750;
}

.player-module-nav {
  min-height: 88rpx;
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  border-top: 1rpx solid var(--line);
  border-bottom: 1rpx solid var(--line);
  background: var(--surface);
}

.player-module-nav view {
  position: relative;
  min-width: 0;
  min-height: 88rpx;
  margin: 0;
  padding: 0 6rpx;
  background: transparent;
  color: var(--ink-subtle);
  font-size: 23rpx;
  line-height: 1.15;
}

.player-module-nav view.active {
  color: var(--brand-strong);
  font-weight: 700;
}

.player-module-nav view.active::after {
  content: '';
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  bottom: 0;
  height: 4rpx;
  border-radius: 4rpx;
  background: var(--brand);
}

.rank-tabs {
  padding: 18rpx 22rpx 10rpx;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10rpx;
  background: var(--surface);
}

.ranking-kind-tabs {
  padding-top: 0;
}

.ranking-kind-tabs > view {
  min-height: 58rpx;
  font-size: 22rpx;
}

.rank-tabs > view {
  min-height: 68rpx;
  margin: 0;
  border-radius: 14rpx;
  background: var(--surface-subtle);
  color: var(--ink-muted);
  font-size: 24rpx;
}

.rank-tabs > view.selected {
  background: var(--brand-strong);
  color: #fff;
  font-weight: 700;
}

.search-box {
  height: 76rpx;
  margin: 14rpx 22rpx;
  padding: 0 22rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  border: 1rpx solid var(--line-strong);
  border-radius: 38rpx;
  background: var(--surface);
}

.search-box input {
  height: 76rpx;
  flex: 1;
  color: var(--ink);
  font-size: 24rpx;
}

.page-state {
  padding: 56rpx 24rpx;
}

.compact-state {
  padding: 28rpx 0;
}

.h2h-panel {
  width: 100%;
  margin: 14rpx 0 40rpx;
  padding: 0 22rpx;
  box-sizing: border-box;
  overflow-x: hidden;
}

.h2h-inputs {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  box-sizing: border-box;
}

.h2h-search-field {
  position: relative;
  z-index: 2;
  width: 100%;
  min-width: 0;
  box-sizing: border-box;
}

.h2h-search-field.first {
  z-index: 4;
}

.h2h-search-field.second {
  z-index: 3;
}

.h2h-input-box {
  width: 100%;
  min-width: 0;
  height: 72rpx;
  padding: 0 18rpx;
  display: flex;
  align-items: center;
  border: 1rpx solid var(--line-strong);
  border-radius: 14rpx;
  background: var(--surface);
  box-sizing: border-box;
}

.h2h-input-box input {
  width: 100%;
  height: 72rpx;
  min-width: 0;
  color: var(--ink);
  font-size: 24rpx;
}

.h2h-vs {
  height: 28rpx;
  color: var(--ink-subtle);
  font-size: 20rpx;
  font-weight: 700;
  line-height: 28rpx;
  text-align: center;
}

.h2h-search-hint {
  min-height: 30rpx;
  padding: 6rpx 4rpx 0;
  color: var(--ink-subtle);
  font-size: 20rpx;
  box-sizing: border-box;
}

.h2h-options {
  position: absolute;
  top: calc(100% + 8rpx);
  right: 0;
  left: 0;
  z-index: 20;
  max-height: 382rpx;
  overflow-y: auto;
  border: 1rpx solid var(--line-strong);
  border-radius: 14rpx;
  background: var(--surface);
  box-shadow: 0 12rpx 28rpx rgba(18, 52, 82, 0.12);
  box-sizing: border-box;
}

.h2h-option {
  min-height: 76rpx;
  padding: 12rpx 16rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  border-bottom: 1rpx solid var(--surface-subtle);
  box-sizing: border-box;
}

.h2h-option:last-child {
  border-bottom: 0;
}

.h2h-option-name,
.h2h-option-meta {
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.h2h-option-name {
  color: var(--ink);
  font-size: 24rpx;
  font-weight: 700;
}

.h2h-option-meta {
  margin-top: 4rpx;
  color: var(--ink-subtle);
  font-size: 19rpx;
}

.h2h-submit {
  width: 100%;
  height: 72rpx;
  margin: 0;
  padding: 0;
  border-radius: 14rpx;
  background: var(--brand-strong);
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 72rpx;
}

.h2h-submit::after {
  border: 0;
}

.h2h-result {
  width: 100%;
  margin-top: 16rpx;
  border: 1rpx solid var(--line);
  border-radius: 24rpx;
  background: var(--surface);
  overflow: hidden;
  box-sizing: border-box;
}

.h2h-scoreboard {
  min-height: 132rpx;
  padding: 20rpx 18rpx;
  display: grid;
  grid-template-columns: minmax(0, 1fr) 150rpx minmax(0, 1fr);
  align-items: center;
  gap: 12rpx;
  border-bottom: 1rpx solid var(--surface-subtle);
}

.h2h-side {
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.h2h-side.right {
  align-items: flex-end;
  text-align: right;
}

.h2h-player {
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: var(--ink);
  font-size: 27rpx;
  font-weight: 750;
}

.h2h-country {
  margin-top: 6rpx;
  color: var(--ink-subtle);
  font-size: 20rpx;
}

.h2h-score {
  display: grid;
  grid-template-columns: 1fr 28rpx 1fr;
  align-items: center;
  justify-items: center;
  color: var(--brand-strong);
  font-size: 40rpx;
  font-weight: 800;
}

.h2h-score-separator {
  color: var(--ink-subtle);
}

.h2h-total {
  grid-column: 1 / 4;
  margin-top: 4rpx;
  color: var(--ink-subtle);
  font-size: 19rpx;
  font-weight: 500;
}

.h2h-empty-line {
  min-height: 70rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-bottom: 1rpx solid var(--surface-subtle);
  color: var(--ink-subtle);
  font-size: 24rpx;
  font-weight: 700;
}

.h2h-section {
  padding: 18rpx 16rpx;
  border-bottom: 1rpx solid var(--surface-subtle);
}

.h2h-section:last-child {
  border-bottom: 0;
}

.h2h-section-title {
  margin-bottom: 12rpx;
  color: var(--ink);
  font-size: 25rpx;
  font-weight: 750;
}

.h2h-stat-head,
.h2h-stat-row {
  display: grid;
  grid-template-columns: minmax(0, 1.35fr) minmax(0, 0.85fr) minmax(0, 0.85fr);
  gap: 10rpx;
  align-items: center;
}

.h2h-stat-head {
  min-height: 44rpx;
  color: var(--ink-subtle);
  font-size: 18rpx;
}

.h2h-stat-head text,
.h2h-stat-row text {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.h2h-stat-head text:nth-child(n + 2),
.h2h-stat-row text:nth-child(n + 2) {
  text-align: right;
}

.h2h-stat-row {
  min-height: 48rpx;
  color: var(--ink);
  font-size: 21rpx;
}

.h2h-stat-row text:first-child {
  color: var(--ink-subtle);
}

.h2h-match-row {
  min-height: 88rpx;
  padding: 12rpx 0;
  display: grid;
  grid-template-columns: minmax(0, 1fr) 104rpx;
  gap: 12rpx;
  border-top: 1rpx solid var(--surface-subtle);
  color: var(--ink-subtle);
  font-size: 20rpx;
}

.h2h-match-row:first-of-type {
  border-top: 0;
}

.h2h-match-row view {
  min-width: 0;
}

.h2h-match-row text {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.h2h-match-date {
  margin-right: 10rpx;
  color: var(--ink);
  font-weight: 700;
}

.h2h-match-title {
  color: var(--ink);
}

.h2h-match-result {
  align-self: center;
  text-align: right;
  color: var(--brand-strong);
  font-weight: 750;
}

.player-list {
  margin: 12rpx 22rpx 40rpx;
  border: 1rpx solid var(--line);
  border-radius: 24rpx;
  background: var(--surface);
  overflow: hidden;
}

.player-row {
  width: 100%;
  min-height: 124rpx;
  margin: 0;
  padding: 16rpx 16rpx;
  display: grid;
  grid-template-columns: 50rpx 70rpx minmax(0, 1fr) 104rpx 60rpx 28rpx;
  align-items: center;
  gap: 12rpx;
  border-bottom: 1rpx solid var(--surface-subtle);
  background: var(--surface);
  text-align: left;
}

.player-row:last-child {
  border-bottom: 0;
}

.rank-number {
  text-align: center;
  color: var(--brand-strong);
  font-size: 25rpx;
  font-weight: 750;
}

.portrait {
  width: 66rpx;
  height: 66rpx;
  border-radius: 50%;
  background: var(--surface-subtle);
}

.portrait.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
}

.player-main {
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.player-name {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: var(--ink);
  font-size: 27rpx;
  font-weight: 700;
}

.player-original {
  margin-top: 2rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: var(--ink-muted);
  font-size: 20rpx;
  font-weight: 520;
}

.player-meta {
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: var(--ink-subtle);
  font-size: 20rpx;
}

.points {
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  color: var(--ink);
  font-size: 25rpx;
  font-weight: 700;
}

.points-label {
  color: var(--ink-subtle);
  font-size: 18rpx;
  font-weight: 400;
}

.movement {
  min-width: 52rpx;
  height: 44rpx;
  padding: 0 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 22rpx;
  background: var(--surface-subtle);
  color: var(--ink-subtle);
  font-size: 22rpx;
  font-weight: 700;
  box-sizing: border-box;
}

.movement.up {
  background: rgba(32,166,106,.10);
  color: var(--success);
}

.movement.down {
  background: rgba(217,45,32,.10);
  color: var(--danger);
}

.movement.same {
  background: var(--surface-subtle);
  color: var(--ink-subtle);
}

.list-tail {
  width: 100%;
  height: 72rpx;
  margin: 0;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 0;
  background: var(--surface);
  color: var(--ink-subtle);
  font-size: 22rpx;
}

.load-more {
  color: var(--brand-strong);
  font-weight: 700;
}

