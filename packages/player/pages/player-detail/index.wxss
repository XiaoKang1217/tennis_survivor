;font-weight:700;text-overflow:ellipsis;white-space:nowrap}.daylight-recent-list>view>view text:last-child{flex:none;color:#8b8b7e;font-size:17rpx}.daylight-recent-list>view>text:nth-child(2){display:inline-flex;margin-top:7rpx;padding:3rpx 9rpx;border-radius:7rpx;background:#e6eee3;color:#3e7856;font-size:17rpx;font-weight:700}.daylight-recent-list>view>text:last-child{display:block;margin-top:7rpx;color:#748078;font-size:19rpx;line-height:1.45}.daylight-recent-list>view>text.daylight-recent-meta{display:block;margin-top:7rpx;padding:0;border-radius:0;background:transparent;color:#8b8b7e;font-size:17rpx;font-weight:500;line-height:1.35}.daylight-recent-list>view>text.daylight-recent-result{display:inline-flex;margin-top:7rpx;padding:3rpx 9rpx;border-radius:7rpx;background:#e6eee3;color:#3e7856;font-size:17rpx;font-weight:700}.daylight-recent-list>view>text.daylight-recent-result.loss{background:#fae7df;color:#b94a35}.daylight-recent-list>view>text.daylight-recent-summary{display:block;margin-top:7rpx;color:#748078;font-size:19rpx;font-weight:400;line-height:1.45}@media(max-width:350px){.daylight-player-hero{min-height:286rpx;padding-right:16rpx;padding-left:16rpx;grid-template-columns:minmax(0,1fr) 190rpx}.daylight-player-visual{width:220rpx;height:270rpx}.daylight-player-name-main{font-size:40rpx}.daylight-player-original-name{font-size:20rpx}.daylight-player-summary{padding-right:12rpx;padding-left:12rpx;grid-template-columns:1fr}.daylight-profile-tabs,.daylight-profile-section{margin-right:12rpx;margin-left:12rpx}.daylight-achievements{grid-template-columns:repeat(3,minmax(0,1fr))}}
.profile-follow-button{min-height:72rpx;margin:16rpx 28rpx;display:flex;align-items:center;justify-content:center;gap:10rpx;border-radius:16rpx;background:var(--brand-strong);color:#fff;font-size:23rpx;font-weight:700}.theme-daylight .profile-follow-button{margin:14rpx 24rpx;background:#54775e;color:#fff}
.profile-actions{margin:16rpx 28rpx 0;display:flex;align-items:center;gap:12rpx}
.profile-actions .profile-follow-button{min-width:0;margin:0;flex:1}
.profile-share-button{min-height:72rpx;margin:0;padding:0 22rpx;flex:0 0 136rpx;display:flex;align-items:center;justify-content:center;gap:8rpx;border:1rpx solid var(--line-strong);border-radius:16rpx;background:var(--surface);color:var(--brand-strong);font-size:22rpx;font-weight:700;line-height:1.2;box-sizing:border-box}
.profile-share-button::after{border:0}
.theme-daylight .profile-actions{margin:14rpx 24rpx 0}
.theme-daylight .profile-share-button{border-color:#d8d5c8;background:#fffdf7;color:#54775e}
@media(max-width:350px){.profile-actions{margin-right:18rpx;margin-left:18rpx}.profile-share-button{flex-basis:118rpx;padding:0 14rpx}}

/* Final dark-mode pass for player detail title and rank cards. */
.detail-page.theme-dark{background:var(--canvas);color:var(--ink)}
.theme-dark .detail-head{background:rgba(17,24,39,.98);border-color:var(--line);color:var(--ink-strong)}
.theme-dark .back-action{background:var(--surface-subtle);border-color:var(--line-strong)}
.theme-dark .hero{background:linear-gradient(135deg,var(--brand-wash),var(--surface));border-color:var(--line);box-shadow:none}
.theme-dark .profile-visual{background:linear-gradient(180deg,var(--surface-subtle),var(--brand-soft))}
.theme-dark .portrait{border-color:var(--surface);background:var(--surface-subtle);box-shadow:none}
.theme-dark .rank-line>view{background:var(--surface-subtle);border-color:var(--line-strong)}
.theme-dark .rank-line text:first-child{color:var(--ink-subtle)}
.theme-dark .rank-line text:last-child{color:var(--brand-ink)}
.theme-dark .summary-group,
.theme-dark .section{background:var(--surface);border-color:var(--line);box-shadow:none}
.theme-dark .summary-grid>view,
.theme-dark .profile-tabs,
.theme-dark .record-cell,
.theme-dark .technical-group{background:var(--surface-subtle)}
.theme-dark .profile-tabs>view.active,
.theme-dark .technical-cell{background:var(--surface)}
.theme-dark .profile-share-button{background:var(--surface);border-color:var(--line-strong);color:var(--brand-strong)}

/* Keep native buttons inside the gift sheet under large fonts and landscape viewports. */
.gift-mask{max-width:100vw;min-width:0;overflow-x:hidden}.gift-dialog{width:100%;max-width:100%;min-width:0;overflow:visible}
.gift-dialog input{width:100%;min-width:0;box-sizing:border-box}
.gift-actions{width:100%;min-width:0;grid-template-columns:repeat(2,minmax(0,1fr));box-sizing:border-box}
.gift-actions .gift-action-button{width:100%;min-width:0;max-width:100%;min-height:88rpx;height:auto;margin:0;padding:12rpx;overflow:visible;line-height:1.2;white-space:normal;word-break:break-all;box-sizing:border-box}.gift-actions .gift-action-button::after{border:0}
.player-name-line{align-items:baseline;gap:3rpx}.player-name-line .player-name{flex:none}.flower-total{padding:0;border:0;background:transparent}
