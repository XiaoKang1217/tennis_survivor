{
  "pages": [
    "pages/scores/index",
    "pages/match-detail/index",
    "pages/draws/index",
    "pages/calendar/index",
    "pages/participation/index",
    "pages/following/index",
    "pages/account/index",
    "pages/social-center/index",
    "pages/flower-ledger/index",
    "pages/legal/index"
  ],
  "subpackages": [
    {
      "root": "packages/player",
      "pages": [
        "pages/players/index",
        "pages/player-detail/index"
      ]
    },
    {
      "root": "packages/tournament",
      "pages": [
        "pages/tournament-detail/index",
        "pages/draw-landscape/index"
      ]
    }
  ],
  "preloadRule": {
    "pages/scores/index": {
      "network": "all",
