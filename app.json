        "packages/player",
        "packages/tournament"
      ]
    },
    "pages/draws/index": {
      "network": "all",
      "packages": [
        "packages/tournament"
      ]
    },
    "pages/calendar/index": {
      "network": "all",
      "packages": [
        "packages/tournament"
      ]
    },
    "pages/following/index": {
      "network": "all",
      "packages": [
        "packages/player",
        "packages/tournament"
      ]
    }
  },
  "window": {
    "navigationStyle": "custom",
    "backgroundColor": "#f1f6fd",
    "backgroundTextStyle": "light",
    "enablePullDownRefresh": false
  },
  "style": "v2",
  "__usePrivacyCheck__": true,
  "lazyCodeLoading": "requiredComponents"
}
