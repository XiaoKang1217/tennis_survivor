.participation-page{padding-bottom:calc(138rpx + env(safe-area-inset-bottom));background:var(--canvas)}.module-head{min-height:108rpx;padding-left:20rpx;padding-right:20rpx;display:grid;grid-template-columns:88rpx 1fr 88rpx;align-items:center;background:var(--surface);box-sizing:content-box}.module-head>view:nth-child(2){display:flex;flex-direction:column;align-items:center}.eyebrow{color:var(--ink-subtle);font-size:21rpx}.title{color:var(--ink);font-size:32rpx;font-weight:750}.module-nav{min-height:88rpx;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));border-top:1rpx solid var(--line);border-bottom:1rpx solid var(--line);background:var(--surface)}.module-nav button{position:relative;min-width:0;margin:0;padding:0 4rpx;background:transparent;color:var(--ink-subtle);font-size:24rpx}.module-nav button.active{color:var(--brand-strong);font-weight:700}.module-nav button.active::after{content:'';position:absolute;left:22rpx;right:22rpx;bottom:0;height:4rpx;background:var(--brand)}.page-state{padding:70rpx 24rpx}
.page-head{background:var(--surface);border-bottom:1rpx solid var(--line)}.title-row{min-height:116rpx;padding:12rpx 28rpx 16rpx;display:flex;align-items:flex-end;box-sizing:border-box}.title-copy{display:flex;flex-direction:column;gap:3rpx}.eyebrow{color:var(--ink-subtle);font-size:24rpx;line-height:1.4}.title{color:var(--ink);font-size:42rpx;line-height:1.15;font-weight:700}.module-nav{width:100%;min-height:90rpx;display:flex;border-top:1rpx solid var(--line);background:var(--surface);box-sizing:border-box}.module{position:relative;flex:1 1 25%;width:25%;min-width:0;min-height:88rpx;padding:8rpx 3rpx 14rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:5rpx;color:var(--ink-subtle);font-size:24rpx;white-space:nowrap;box-sizing:border-box}.module.active{color:var(--brand-strong);font-weight:650}.module.active::after{content:'';position:absolute;left:24rpx;right:24rpx;bottom:0;height:4rpx;border-radius:4rpx;background:var(--brand)}
.participation-page.theme-daylight{padding-bottom:calc(126rpx + env(safe-area-inset-bottom));background:#f5f1e6}.daylight-participation-content{padding:24rpx}.daylight-participation-tabs{margin-bottom:18rpx}.daylight-summary{display:flex}.daylight-summary>view{min-width:0;min-height:116rpx;flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:5rpx;border-right:1rpx solid #ece8dd}.daylight-summary>view:last-child{border-right:0}.daylight-summary text:first-child{color:#54775e;font-family:"Songti SC",STSong,Georgia,serif;font-size:32rpx;font-weight:700}.daylight-summary text:last-child{color:#8b8b7e;font-size:17rpx;text-align:center}.daylight-empty-update{margin-top:18rpx;padding:58rpx 34rpx;display:flex;flex-direction:column;align-items:center;text-align:center}.daylight-empty-mark{width:70rpx;height:70rpx;margin-bottom:18rpx;display:flex;align-items:center;justify-content:center;border:1rpx solid #c6d0c4;border-radius:50%;color:#d88b62;font-family:Georgia,serif;font-size:35rpx}.daylight-empty-update>text:last-child{max-width:560rpx;margin-top:12rpx;color:#748078;font-size:21rpx;line-height:1.7}
