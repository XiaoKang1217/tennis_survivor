px + env(safe-area-inset-bottom));background:#f5f1e6}.follow-tabs-daylight{background:#f5f1e6;box-shadow:none}.follow-tabs-daylight .follow-tab{background:#ebe9dc;color:#748078}.follow-tabs-daylight .follow-tab.active{background:#e6efe2;color:#54775e}.follow-tabs-daylight .follow-tab.active text:last-child{background:#54775e}.follow-summary-daylight{border-color:#d8d5c8;background:#fffdf7}.follow-summary-daylight text:first-child{color:#25342a}.follow-summary-daylight text:last-child{color:#748078}.follow-feed-daylight .follow-date-head text:first-child{color:#25342a}.player-badge-daylight,.follow-event-card-daylight{border-color:#d8d5c8;background:#fffdf7;box-shadow:0 14rpx 28rpx rgba(60,70,48,.08)}.player-badge-daylight .rank-badge{background:#54775e}.player-badge-daylight .tour-wordmark{color:#54775e}.player-badge-daylight .tour-wordmark.wta{color:#b05274}.player-badge-daylight .verified-dot{background:#54775e}.player-badge-daylight .player-tags .primary{background:#54775e}.player-badge-daylight .player-tags text{background:#edf0e5;color:#596659}.follow-event-card-daylight .event-kind{background:#edf0e5;color:#54775e}.follow-event-card-daylight .event-side view{background:#edf0e5}@media(max-width:350px){.follow-summary{align-items:flex-start;flex-direction:column}.follow-summary text:last-child{white-space:normal}.player-photo{width:150rpx}.player-name{font-size:28rpx}.player-stats view text:nth-child(2){font-size:26rpx}.player-tags text{font-size:18rpx;padding:0 9rpx}}
.follow-notice{margin:14rpx 22rpx 0}
.match-status-tabs{padding:12rpx 22rpx 0;display:grid;grid-template-columns:repeat(3,1fr);gap:10rpx}.match-status-tabs>view{height:58rpx;display:flex;align-items:center;justify-content:center;border:1rpx solid var(--line);border-radius:13rpx;background:var(--surface);color:var(--ink-subtle);font-size:21rpx}.match-status-tabs>view.active{border-color:var(--brand-strong);background:var(--brand-strong);color:#fff}.follow-login-button{height:70rpx;margin:18rpx auto 0;padding:0 34rpx;border:0;border-radius:14rpx;background:var(--brand-strong);color:#fff;font-size:23rpx;line-height:70rpx}
