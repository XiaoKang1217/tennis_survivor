<view class="safe-page following-page theme-{{uiTheme}}">
    <view class="root-head" style="padding-top:{{topInset}}px"><text class="title">我的关注</text></view>
    <view class="follow-tabs">
      <view wx:for="{{tabs}}" wx:key="id" data-kind="{{item.id}}" bindtap="selectKind" class="follow-tab {{selectedKind === item.id ? 'active' : ''}}" role="button"><text>{{item.label}}</text><text>{{item.count}}</text></view>
    </view>
    <view wx:if="{{selectedKind === 'match'}}" class="match-status-tabs"><view wx:for="{{matchStatusTabs}}" wx:key="id" data-status="{{item.id}}" bindtap="selectMatchStatus" class="{{selectedMatchStatus === item.id ? 'active' : ''}}">{{item.label}}</view></view>
    <view class="follow-summary"><text>{{selectedKind === 'match' ? count + ' 场比赛' : count + ' 位球员'}}</text><text>{{matchCount}} 比赛 · {{playerCount}} 球员</text></view>
    <view wx:if="{{authPrompt}}" class="follow-state"><client-state state="empty" label="登录后查看我的关注" message="选择头像和昵称，即可在不同设备同步关注"/><button class="follow-login-button" bindtap="promptForProfile">登录并查看</button></view>
    <block wx:else>
    <view wx:if="{{deliveryMessage}}" class="follow-notice"><data-notice state="{{deliveryState}}" message="{{deliveryMessage}}" dataAsOf="{{dataAsOf}}" compact="{{true}}"/></view>
    <view wx:if="{{loading && !items.length}}" class="follow-state"><client-state state="loading" label="关注内容加载中" message=""/></view>
    <view wx:elif="{{failed}}" class="follow-state"><client-state state="failed" label="关注内容加载失败" message="请下拉刷新或稍后重试" retryable bind:retry="load"/></view>
    <view wx:elif="{{!count}}" class="follow-state"><client-state state="empty" label="还没有关注内容" message="去关注你想看的比赛、球员或赛事"/></view>
    <view wx:else class="follow-feed">
      <view wx:for="{{dateGroups}}" wx:key="id" class="follow-date-group">
        <view class="follow-date-head"><text>{{item.label}}</text><text>{{item.countLabel}}</text></view>
        <block wx:for="{{item.items}}" wx:for-item="entry" wx:key="key">
          <view wx:if="{{entry.type === 'player'}}" class="player-badge" data-id="{{entry.player.id}}" bindtap="openPlayer" role="button">
            <view class="player-photo">
              <image wx:if="{{entry.player.portraitUrl}}" src="{{entry.player.portraitUrl}}" mode="aspectFit" lazy-load="{{true}}"/>
              <ui-icon wx:else name="player" size="30" color="#8aa0b5"/>
              <text class="rank-badge">{{entry.player.rankBadge}}</text>
            </view>
            <view class="player-badge-copy">
              <view class="player-name-row"><text class="player-name">{{entry.player.name}}</text><text class="tour-wordmark {{entry.player.authorityClass}}">{{entry.player.authority}}</text><view class="player-heart" data-id="{{entry.player.followTargetId}}" catchtap="togglePlayerFollow" role="button"><ui-icon name="heart" size="17" color="#ff3b30"/></view></view>
              <view class="player-country-row"><text wx:if="{{entry.player.countryMark}}">{{entry.player.countryMark}}</text><text>{{entry.player.originalName || entry.player.countryCode || '国家/地区暂缺'}}</text><view class="verified-dot"/></view>
              <view class="player-stats">
                <view><text>世界排名</text><text>{{entry.player.rankingLabel}}</text><text class="movement movement-{{entry.player.movementTone}}">{{entry.player.movementText}}</text></view>
                <view><text>Race排名</text><text>{{entry.player.raceLabel}}</text></view>
                <view><text>年龄</text><text>{{entry.player.ageLabel}}</text></view>
              </view>
              <view class="player-tags"><text class="primary">{{entry.player.seasonTitlesLabel}}</text><text>{{entry.player.recentRecordLabel}}</text></view>
              <text class="player-activity">{{entry.player.followCountLabel}}</text>
            </view>
          </view>
          <match-card wx:else match="{{entry.match}}" theme="{{uiTheme}}" bind:open="openMatch" bind:follow="toggleFollow"/>
        </block>
      </view>
      <view wx:if="{{loadingMore}}" class="follow-load-more">加载中</view>
      <view wx:elif="{{hasMore}}" class="follow-load-more" bindtap="loadMore" role="button">加载更多</view>
      <view wx:else class="follow-load-more">已加载全部关注</view>
    </view>
    </block>
  <product-tabbar active="following" theme="{{uiTheme}}"/>
  <profile-gate id="profileGate" theme="{{uiTheme}}"/>
</view>
