px;padding-right:10rpx;padding-left:10rpx;gap:6rpx}.daylight-draw-picker>button{padding:0 6rpx}.daylight-tournament-picker>view>view{width:208rpx}}

/* Longer localized player names need two compact lines instead of single-line truncation. */
.draw-match{height:196rpx;min-height:196rpx;padding:12rpx 14rpx;line-height:normal}
.side-row{min-height:62rpx;grid-template-columns:30rpx minmax(0,1fr) 30rpx minmax(62rpx,auto);gap:5rpx}
.side-row.no-score{grid-template-columns:30rpx minmax(0,1fr) 30rpx}
.participant{display:-webkit-box;overflow:hidden;color:var(--ink-muted);font-size:19rpx;line-height:1.16;text-overflow:clip;white-space:normal;word-break:break-word;-webkit-box-orient:vertical;-webkit-line-clamp:2}
.side-row.winner .participant{color:var(--ink-strong);font-weight:800}
.champion-row{min-height:112rpx;grid-template-columns:30rpx minmax(0,1fr) 38rpx}
.champion-match .participant{font-size:20rpx;line-height:1.18}
.match-meta{min-height:34rpx;padding-top:7rpx}
@media(max-width:340px){.draw-match{height:196rpx;min-height:196rpx}.side-row{grid-template-columns:28rpx minmax(0,1fr) 28rpx minmax(58rpx,auto)}.side-row.no-score{grid-template-columns:28rpx minmax(0,1fr) 28rpx}.participant{font-size:18rpx}}

.draw-picker{grid-template-columns:minmax(130rpx,210rpx) minmax(0,1fr) 86rpx 102rpx}
.draw-picker .draw-share-button,.draw-picker .fullscreen-toggle{min-height:58rpx;margin:0!important;padding:0 12rpx;display:flex;align-items:center;justify-content:center;gap:6rpx;border:1rpx solid var(--line-strong)!important;border-radius:13rpx;background:var(--surface);color:var(--brand-ink)!important;font-size:18rpx;line-height:1.2;box-sizing:border-box}
.draw-picker .draw-share-button::after,.draw-picker .fullscreen-toggle::after{border:0}
.fullscreen .draw-picker{grid-template-columns:minmax(120rpx,190rpx) minmax(0,1fr) 82rpx 100rpx}
.daylight-draw-picker{grid-template-columns:minmax(126rpx,190rpx) minmax(0,1fr) 82rpx 96rpx}
.daylight-draw-picker .draw-share-button{display:flex;align-items:center;justify-content:center;gap:5rpx;color:#54775e}
.daylight-draw-picker .draw-share-button::after{border:0}
.theme-daylight.fullscreen .daylight-draw-picker{grid-template-columns:minmax(120rpx,184rpx) minmax(0,1fr) 78rpx 94rpx}
@media(max-width:340px){.draw-picker{grid-template-columns:104rpx minmax(0,1fr) 72rpx 82rpx;padding-left:12rpx;padding-right:12rpx;gap:7rpx}.draw-picker .draw-share-button,.draw-picker .fullscreen-toggle{padding:0 7rpx;font-size:16rpx}.daylight-draw-picker{grid-template-columns:102rpx minmax(0,1fr) 68rpx 78rpx;padding-right:10rpx;padding-left:10rpx;gap:6rpx}.daylight-draw-picker .draw-share-button,.daylight-draw-picker>button{padding:0 5rpx;font-size:16rpx}}

/* Final theme polish: keep dark mode dark and make draw switching visibly scrollable. */
.draw-page.theme-dark{background:var(--canvas)}
.theme-dark .page-head,
.theme-dark .draw-controls,
.theme-dark .draw-picker{background:var(--surface);border-color:var(--line)}
.theme-dark .title-row{background:linear-gradient(180deg,var(--surface),var(--surface-subtle))}
.theme-dark .draw-board{background:var(--canvas-subtle)}
.theme-dark .round-title{background:rgba(17,24,39,.98);color:var(--ink-muted)}
.theme-dark .draw-match{background:var(--surface);border-color:var(--line);box-shadow:none}
.theme-dark .champion-match{background:linear-gradient(135deg,var(--brand-wash),var(--surface))}
.theme-dark .draw-picker .draw-share-button,
.theme-dark .draw-picker .fullscreen-toggle{background:var(--surface-subtle);border-color:var(--line-strong)!important;color:var(--brand-strong)!important}
.theme-dark .draw-picker button{background:var(--surface-subtle);color:var(--ink-muted)}
.theme-dark .draw-picker button.selected{background:var(--brand-strong);color:#07111f}
.draw-picker{grid-template-columns:minmax(0,1fr) 82rpx 92rpx}
.draw-type-scroll{width:100%;min-width:0}
.draw-types{min-width:100%;display:inline-flex;gap:8rpx;padding-right:14rpx;box-sizing:border-box}
.draw-types button{min-width:132rpx;max-width:188rpx;padding:0 14rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.draw-picker .draw-share-button,
.draw-picker .fullscreen-toggle{min-width:0;padding:0 8rpx;font-size:17rpx}
.fullscreen .draw-picker{grid-template-columns:minmax(0,1fr) 74rpx 86rpx}
.daylight-draw-picker{grid-template-columns:minmax(0,1fr) 74rpx 88rpx}
.daylight-draw-picker scroll-view{width:100%;min-width:0}
.daylight-draw-picker scroll-view>view{min-width:100%;padding-right:12rpx;box-sizing:border-box}
.daylight-draw-picker button{min-width:126rpx;max-width:178rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.daylight-draw-picker .draw-share-button,
.daylight-draw-picker>button:last-child{min-width:0;padding:0 6rpx;font-size:16rpx}
.theme-daylight.fullscreen .daylight-draw-picker{grid-template-columns:minmax(0,1fr) 70rpx 82rpx}
@media(max-width:340px){
  .draw-picker{grid-template-columns:minmax(0,1fr) 66rpx 78rpx}
  .draw-types button{min-width:118rpx;max-width:156rpx;padding:0 10rpx}
  .draw-picker .draw-share-button,.draw-picker .fullscreen-toggle{padding:0 4rpx;font-size:15rpx}
  .daylight-draw-picker{grid-template-columns:minmax(0,1fr) 62rpx 74rpx}
  .daylight-draw-picker button{min-width:112rpx;max-width:146rpx}
}
