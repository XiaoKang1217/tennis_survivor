.landscape-page{
  width:100vw;
  height:100vh;
  overflow:hidden;
  background:var(--canvas);
  color:var(--ink);
}
.landscape-toolbar{
  min-height:84rpx;
  padding-left:14rpx;
  padding-right:14rpx;
  display:flex;
  align-items:center;
  gap:10rpx;
  border-bottom:1rpx solid var(--line);
  background:var(--surface);
  box-sizing:border-box;
}
.landscape-toolbar button{
  min-height:52rpx;
  margin:0;
  padding:0 14rpx;
  display:flex;
  align-items:center;
  justify-content:center;
  border:1rpx solid var(--line);
  border-radius:14rpx;
  background:var(--surface-subtle);
  color:var(--brand-strong);
  font-size:20rpx;
  line-height:1.2;
  white-space:nowrap;
}
.landscape-toolbar button::after{
  border:0;
}
.toolbar-title{
  min-width:210rpx;
  flex:1;
  display:flex;
  flex-direction:column;
  gap:2rpx;
}
.toolbar-title text:first-child{
  overflow:hidden;
  color:var(--ink);
  font-size:23rpx;
  font-weight:800;
  text-overflow:ellipsis;
  white-space:nowrap;
}
.toolbar-title text:last-child{
  color:var(--brand-strong);
  font-size:18rpx;
  font-weight:700;
}
.landscape-state{
  height:calc(100vh - 84rpx);
  padding:80rpx 32rpx;
  box-sizing:border-box;
}
.landscape-board{
  width:100vw;
  height:calc(100vh - 84rpx);
  background-color:var(--canvas);
  background-image:linear-gradient(var(--line) 1rpx, transparent 1rpx),linear-gradient(90deg,var(--line) 1rpx,transparent 1rpx);
  background-size:36rpx 36rpx;
}
.bracket-board{
  min-width:1800rpx;
  min-height:980rpx;
  padding:28rpx 44rpx 90rpx;
  display:inline-flex;
  gap:68rpx;
  align-items:flex-start;
  transition:transform .16s ease;
  box-sizing:border-box;
}
.bracket-board.overview{
  opacity:.92;
}
.bracket-column{
  width:430rpx;
  flex:0 0 430rpx;
}
.round-title{
  position:sticky;
  top:0;
  z-index:3;
  height:58rpx;
  padding:12rpx 14rpx;
  display:block;
  border-radius:14rpx;
  background:var(--brand-soft);
  color:var(--brand-strong);
  font-size:22rpx;
  font-weight:800;
  box-sizing:border-box;
}
.selected-round .round-title{
  background:var(--brand);
  color:#fff;
}
.round-body{
  position:relative;
  margin-top:14rpx;
  width:430rpx;
}
.bracket-node{
  position:absolute;
  left:0;
  width:430rpx;
  height:196rpx;
  min-height:196rpx;
  margin:0;
  padding:12rpx 14rpx;
  overflow:visible;
  border:1rpx solid var(--line);
  border-radius:18rpx;
  background:var(--surface);
  box-shadow:0 10rpx 26rpx rgba(21,55,96,.08);
  text-align:left;
  box-sizing:border-box;
}
.bracket-node::after{
  content:'';
  position:absolute;
  right:-68rpx;
  top:50%;
  width:68rpx;
  height:2rpx;
  background:var(--line-strong);
}
.bracket-column:last-child .bracket-node::after{
  display:none;
}
.bracket-node::after,
.connector-in,
.connector-in::after{
  background:var(--line-strong);
}
.connector-in{
  position:absolute;
  left:-34rpx;
  width:2rpx;
}
.connector-in::after{
  content:'';
  position:absolute;
  left:0;
  top:50%;
  width:34rpx;
  height:2rpx;
}
.node-side{
  position:relative;
  min-height:62rpx;
  display:grid;
  grid-template-columns:32rpx minmax(0,1fr) auto;
  align-items:center;
  gap:8rpx;
  border-bottom:1rpx solid var(--surface-subtle);
}
.node-side.winner::before{
  content:'';
  position:absolute;
  left:-14rpx;
  top:10rpx;
  bottom:10rpx;
  width:5rpx;
  border-radius:0 5rpx 5rpx 0;
  background:var(--brand);
}
.node-side>text:nth-child(2){
  min-width:0;
  overflow:hidden;
  color:var(--ink);
  font-size:21rpx;
  font-weight:650;
  text-overflow:ellipsis;
  white-space:nowrap;
}
.node-side.winner>text:nth-child(2){
  color:var(--ink-strong);
  font-weight:850;
}
.seed,
.entry{
  color:var(--ink-subtle);
  font-size:16rpx;
}
.node-scores{
  display:flex;
  align-items:center;
  justify-content:flex-end;
  gap:5rpx;
}
.node-scores>text{
  position:relative;
  min-width:24rpx;
  color:var(--ink);
  font-size:20rpx;
  font-weight:800;
  text-align:right;
}
.tiebreak{
  position:absolute;
  right:-2rpx;
  top:-9rpx;
  color:var(--ink-subtle);
  font-size:10rpx;
}
.node-foot{
  min-height:36rpx;
  padding-top:8rpx;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:12rpx;
}
.node-foot text{
  overflow:hidden;
  color:var(--ink-subtle);
  font-size:17rpx;
  text-overflow:ellipsis;
  white-space:nowrap;
}
.champion-node{
  border-color:var(--brand);
  background:linear-gradient(135deg,var(--brand-wash),var(--surface));
}
.champion-line{
  min-height:116rpx;
  display:grid;
  grid-template-columns:32rpx minmax(0,1fr) auto;
  align-items:center;
  gap:8rpx;
}
.champion-line text:nth-child(2){
  overflow:hidden;
  color:var(--ink-strong);
  font-size:24rpx;
  font-weight:880;
  text-overflow:ellipsis;
  white-space:nowrap;
}
.node-status{
  color:var(--brand-strong);
  font-size:19rpx;
  font-weight:800;
}
.mini-map{
  position:fixed;
  right:18rpx;
  bottom:18rpx;
  z-index:4;
  width:148rpx;
  height:88rpx;
  border:1rpx solid var(--line);
  border-radius:18rpx;
  background:rgba(255,255,255,.88);
  box-shadow:0 10rpx 26rpx rgba(21,55,96,.12);
}
.mini-map::before{
  content:'';
  position:absolute;
  left:18rpx;
  right:18rpx;
  top:18rpx;
  bottom:18rpx;
  background:repeating-linear-gradient(90deg,var(--line),var(--line) 1rpx,transparent 1rpx,transparent 24rpx);
}
.mini-map>view{
  position:absolute;
  left:48rpx;
  top:24rpx;
  width:58rpx;
  height:40rpx;
  border:3rpx solid var(--brand);
  border-radius:8rpx;
}
.theme-dark .mini-map{
  background:rgba(21,33,53,.9);
}
.theme-daylight .landscape-page{
  background:#f5f1e6;
}
.theme-daylight .landscape-toolbar,
.theme-daylight .bracket-node{
  border-color:#d8d5c8;
  background:#fffdf7;
}
.theme-daylight .landscape-board{
  background-color:#edf0e5;
}
.theme-daylight .round-title,
.theme-daylight .landscape-toolbar button{
  background:#e6eee3;
  color:#54775e;
}
.theme-daylight .selected-round .round-title,
.theme-daylight .node-side.winner::before{
  background:#54775e;
  color:#fff;
}
