.module-state.theme-clean-blue{--brand:#339cff;--brand-strong:#1677d2;--ink:#1a1c1f;--ink-subtle:#66788a;--line-strong:#d4e1ed;--surface:#fff}
.module-state.theme-dark{--brand:#60a5fa;--brand-strong:#38bdf8;--ink:#e5eef8;--ink-subtle:#94a3b8;--line-strong:#33465c;--surface:#111827}
.module-state.theme-daylight{--brand:#d88b62;--brand-strong:#54775e;--ink:#233028;--ink-subtle:#8b8b7e;--line-strong:#d8d5c8;--surface:#fffdf7}
.module-state { min-height:330rpx; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:14rpx; padding:38rpx; text-align:center; color:var(--ink-subtle); }
.title { color:var(--ink); font-size:28rpx; font-weight:700; }
.message { max-width:520rpx; font-size:23rpx; line-height:1.55; }
.data-as-of { max-width:520rpx; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; color:var(--ink-subtle); font-size:18rpx; }
.retry { margin-top:8rpx; padding:0 28rpx; min-height:88rpx; display:flex; align-items:center; border:1rpx solid var(--line-strong); border-radius:18rpx; background:var(--surface); color:var(--brand-strong); font-size:24rpx; }
.loading-mark { width:44rpx; height:44rpx; border:5rpx solid var(--line-strong); border-top-color:var(--brand); border-radius:50%; animation:spin .8s linear infinite; }
@keyframes spin { to { transform:rotate(360deg); } }
@media (prefers-reduced-motion: reduce) { .loading-mark { animation:none; } }
.module-state.theme-daylight{color:#748078}.theme-daylight .retry{border-radius:18rpx}
