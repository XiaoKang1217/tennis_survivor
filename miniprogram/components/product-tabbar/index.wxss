.product-tabbar.theme-clean-blue{--tabbar-line:#d7e2f0;--tabbar-bg:rgba(255,255,255,.98);--tabbar-muted:#64758a;--tabbar-active:#1769df}
.product-tabbar.theme-dark{--tabbar-line:#2d405b;--tabbar-bg:rgba(21,33,53,.98);--tabbar-muted:#a7b7cb;--tabbar-active:#9bc4ff}
.product-tabbar.theme-daylight{--tabbar-line:#d8dccf;--tabbar-bg:rgba(255,253,248,.98);--tabbar-muted:#6a756c;--tabbar-active:#187a59}
.product-tabbar{position:fixed;z-index:20;left:0;right:0;bottom:0;min-height:calc(112rpx + env(safe-area-inset-bottom));padding:10rpx 14rpx calc(12rpx + env(safe-area-inset-bottom));display:flex;align-items:flex-start;border-top:1rpx solid var(--tabbar-line,#e5edf5);background:var(--tabbar-bg,rgba(255,255,255,.98));box-sizing:border-box}.tabbar-button{width:25%;min-width:0;min-height:88rpx;margin:0;padding:0;flex:1 1 25%;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4rpx;background:transparent;color:var(--tabbar-muted,#66788a);font-size:20rpx}.tabbar-button.active{color:var(--tabbar-active,#339cff);font-weight:650}
