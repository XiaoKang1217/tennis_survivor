<view wx:if="{{state !== 'live' || !compact}}" class="notice notice-{{state}} {{compact ? 'compact' : ''}} theme-{{theme}}">
  <ui-icon name="info" size="15" color="{{state === 'unavailable' ? (theme === 'daylight' ? '#c65349' : (theme === 'dark' ? '#ff8585' : '#d64a4a')) : state === 'delayed' || state === 'stale' ? (theme === 'daylight' ? '#c65349' : (theme === 'dark' ? '#fbbf24' : '#0f4fac')) : (theme === 'daylight' ? '#6a756c' : (theme === 'dark' ? '#9bc4ff' : '#0f4fac'))}}" />
  <view class="notice-copy">
    <text wx:if="{{message}}">{{message}}</text>
    <text wx:if="{{displayTime}}" class="time">更新于 {{displayTime}}</text>
  </view>
</view>
