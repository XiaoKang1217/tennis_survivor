<view class="client-state state-{{state}} theme-{{theme}}">
  <view wx:if="{{state === 'loading'}}" class="loading-mark" />
  <ui-icon wx:else name="{{state === 'failed' ? 'retry' : 'info'}}" size="26" color="{{state === 'failed' ? (theme === 'daylight' ? '#b6533d' : (theme === 'dark' ? '#fb7185' : '#a13d42')) : (theme === 'daylight' ? '#748078' : (theme === 'dark' ? '#94a3b8' : '#526171'))}}" />
  <text class="label">{{label}}</text>
  <text wx:if="{{message}}" class="message">{{message}}</text>
  <button wx:if="{{state === 'failed' && retryable}}" class="retry" bindtap="retry">重新尝试</button>
</view>
