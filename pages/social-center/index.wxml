<page-meta page-style="{{themePageStyle}}" background-color="{{themeCanvas}}" background-text-style="{{themeBackgroundTextStyle}}"/>
<view class="safe-page social-page theme-{{uiTheme}}">
  <view class="social-head" style="padding-top:{{topInset}}px"><view bindtap="back" role="button"><ui-icon name="back" size="19" color="{{themeAccentStrong}}"/></view><text>签到与花朵</text><view/></view>
  <view wx:if="{{loading}}" class="page-state"><client-state state="loading" label="正在读取花朵账户"/></view>
  <view wx:elif="{{failed}}" class="page-state"><client-state state="failed" label="花朵账户暂不可用" retryable bind:retry="load"/></view>
  <block wx:else>
    <view class="wallet-card"><text>可用花朵</text><view class="wallet-balance"><text class="flower-emoji flower-emoji-wallet">🌸</text><text>{{wallet.balance}}</text></view><view><text>累计获得 {{wallet.lifetimeEarned}}</text><text>累计送出 {{wallet.lifetimeSpent}}</text></view><text>{{wallet.disclaimer}}</text></view>
    <view class="reward-card"><view class="reward-title"><view><text>连续签到奖励</text><text>连续 {{checkins.currentStreak}} 天 · 当前第 {{checkins.currentCycleDay}} 天</text></view><text>7天共65朵</text></view><view class="reward-cycle"><view wx:for="{{checkins.cycleRewards}}" wx:key="day" class="{{item.state}} {{item.current ? 'current' : ''}}"><text>{{item.dayLabel}}</text><text class="flower-emoji">{{item.claimed ? '🌸' : '·'}}</text><text>{{item.rewardLabel}}</text></view></view></view>
    <view class="calendar-card"><view class="calendar-head"><view bindtap="previousMonth">‹</view><text>{{month}}</text><view bindtap="nextMonth">›</view></view><view class="calendar-tools"><text>本月 {{checkins.monthlyProgress.checkedDays}}/{{checkins.monthlyProgress.daysInMonth}} 天</text><text bindtap="today">回到本月</text></view><view class="monthly-bonus {{checkins.monthlyProgress.earned ? 'earned' : ''}}"><view><text>整月全勤奖励</text><text>{{checkins.monthlyProgress.eligibilityMessage}}</text></view><text>🌸 +{{checkins.monthlyProgress.bonus}}</text></view><view class="week-head"><text wx:for="{{weekLabels}}" wx:key="*this">{{item}}</text></view><view class="calendar-grid"><view wx:for="{{calendarCells}}" wx:key="key" class="{{item.blank ? 'blank' : ''}} {{item.checked ? 'checked' : ''}}"><text wx:if="{{!item.blank}}">{{item.day}}</text><text wx:if="{{item.checked}}" class="flower-emoji flower-emoji-calendar">🌸</text></view></view><button bindtap="checkin" disabled="{{checkins.checkedInToday}}">{{checkins.checkedInToday ? '今日已签到' : '签到领 ' + checkins.dailyCheckinReward + ' 朵花'}}</button></view>
    <view class="social-section"><text class="section-title">我的粉丝勋章</text><view wx:if="{{badges.length}}" class="badge-list"><view wx:for="{{badges}}" wx:key="playerId"><view><text>{{item.label}}</text><text>{{item.equipped ? '佩戴中' : '未佩戴'}}</text></view><view class="badge-actions"><button open-type="share" data-player-id="{{item.playerId}}" data-label="{{item.label}}">分享</button><button data-player-id="{{item.playerId}}" data-equipped="{{item.equipped}}" bindtap="toggleBadge">{{item.equipped ? '取消佩戴' : '佩戴'}}</button></view></view></view><text wx:else class="empty-copy">为同一位球员累计送出 10 朵花，即可获得“XX的粉丝”勋章。</text></view>
    <view class="social-section"><view class="section-title-row"><text class="section-title">花朵明细</text><view bindtap="openLedger" role="button"><text>查看全部</text><ui-icon name="chevron" size="14" color="{{themeAccentStrong}}"/></view></view><view wx:if="{{ledger.length}}" class="ledger-list"><view wx:for="{{ledger}}" wx:key="ledgerId"><view><text>{{item.reasonText}}</text><text>{{item.dateLabel}}</text></view><text class="{{item.delta > 0 ? 'income' : 'expense'}}">{{item.delta > 0 ? '+' : ''}}{{item.delta}}</text></view></view><text wx:else class="empty-copy">暂无花朵明细</text></view>
  </block>
  <profile-gate id="profileGate" theme="{{uiTheme}}"/>
</view>
