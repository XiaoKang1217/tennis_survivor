.flower-emoji{display:inline-block;line-height:1}.flower-emoji-wallet{font-size:36rpx}.flower-emoji-calendar{font-size:17rpx}
.social-page{min-height:100vh;padding-bottom:50rpx;background:var(--canvas);color:var(--ink)}.social-head{min-height:82rpx;padding-right:22rpx;padding-left:22rpx;display:grid;grid-template-columns:54rpx 1fr 54rpx;align-items:center;background:var(--surface);border-bottom:1rpx solid var(--line);box-sizing:content-box}.social-head>view{display:flex;align-items:center}.social-head>text{text-align:center;font-size:28rpx;font-weight:800}.page-state{padding:100rpx 24rpx}.wallet-card,.calendar-card,.social-section{margin:20rpx 22rpx 0;padding:24rpx;border:1rpx solid var(--line);border-radius:22rpx;background:var(--surface)}.wallet-card>text:first-child{color:var(--ink-subtle);font-size:21rpx}.wallet-card>text:nth-child(2){display:block;margin-top:4rpx;font-size:50rpx;font-weight:850}.wallet-card>view{margin-top:14rpx;display:flex;gap:22rpx;color:var(--ink-subtle);font-size:20rpx}.wallet-card>text:last-child{display:block;margin-top:16rpx;color:var(--ink-muted);font-size:17rpx;line-height:1.45}.calendar-head{display:grid;grid-template-columns:48rpx 1fr 48rpx;align-items:center;text-align:center}.calendar-head>view{height:48rpx;border-radius:12rpx;background:var(--brand-soft);color:var(--brand-strong);font-size:34rpx;line-height:45rpx}.calendar-head>text{font-size:27rpx;font-weight:800}.calendar-tools{margin-top:12rpx;display:flex;justify-content:space-between;color:var(--ink-subtle);font-size:18rpx}.calendar-tools text:last-child{color:var(--brand-strong)}.week-head,.calendar-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:7rpx}.week-head{margin-top:18rpx;color:var(--ink-muted);font-size:17rpx;text-align:center}.calendar-grid{margin-top:8rpx}.calendar-grid>view{height:64rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;border-radius:10rpx;background:var(--canvas-subtle);font-size:18rpx}.calendar-grid>view.checked{background:var(--brand-soft);color:var(--brand-strong)}.calendar-grid>view.blank{background:transparent}.calendar-card>button{height:68rpx;margin-top:18rpx;border:0;border-radius:14rpx;background:var(--brand-strong);color:#fff;font-size:23rpx;line-height:68rpx}.calendar-card>button[disabled]{background:var(--surface-subtle);color:var(--ink-muted)}.section-title{font-size:27rpx;font-weight:800}.empty-copy{display:block;margin-top:14rpx;color:var(--ink-subtle);font-size:20rpx;line-height:1.55}.badge-list,.ledger-list{margin-top:12rpx}.badge-list>view,.ledger-list>view{min-height:82rpx;display:flex;align-items:center;justify-content:space-between;border-top:1rpx solid var(--line)}.badge-list>view>view,.ledger-list>view>view{display:flex;flex-direction:column}.badge-list>view>view text:last-child,.ledger-list>view>view text:last-child{margin-top:4rpx;color:var(--ink-muted);font-size:17rpx}.badge-list button{height:52rpx;margin:0;padding:0 18rpx;border:1rpx solid var(--line);border-radius:12rpx;background:var(--brand-soft);color:var(--brand-strong);font-size:18rpx;line-height:50rpx}.ledger-list>view>text{font-size:25rpx;font-weight:800}.ledger-list .income{color:#11a36a}.ledger-list .expense{color:#df5b4b}
