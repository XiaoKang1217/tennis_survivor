.hero-player.side-0 .hero-identity,.daylight-hero-side.side-0 .daylight-hero-identity{justify-content:flex-start}
.hero-player.side-1 .hero-identity,.daylight-hero-side.side-1 .daylight-hero-identity{justify-content:flex-end}
.hero-identity .portrait-stack,.daylight-hero-identity .daylight-hero-portraits{flex:0 0 auto}

