.detail-actions,.daylight-detail-actions{position:relative;padding-top:38rpx}.detail-follow-count{position:absolute;top:6rpx;left:22rpx;max-width:260rpx;overflow:hidden;color:var(--ink-subtle);font-size:20rpx;line-height:28rpx;text-overflow:ellipsis;white-space:nowrap}.theme-daylight .detail-follow-count{color:#748078}@media(max-width:350px){.detail-actions,.daylight-detail-actions{padding-top:36rpx}.detail-follow-count{left:14rpx;max-width:220rpx;font-size:18rpx}}

/* Keep live score rows optically centered and put server identity inside the score table. */
.score-board-row,.daylight-score-row{align-items:center}
.score-player-cell,.daylight-score-player-cell{min-width:0;display:flex;align-items:center;gap:7rpx;overflow:hidden;line-height:1.15}
.score-player-name,.daylight-score-player-cell>text:first-child{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;line-height:1.18}
.score-server-badge,.daylight-score-server{flex:0 0 auto;min-width:42rpx;height:28rpx;padding:0 8rpx;display:inline-flex;align-items:center;justify-content:center;border-radius:999rpx;font-size:14rpx;font-weight:760;line-height:1;box-sizing:border-box}
.score-server-badge{background:rgba(217,45,32,.10);color:var(--live)}
.daylight-score-server{background:#fff0e7;color:#b95a3b}
.set-score-track,.daylight-score-row>view:nth-child(2){align-items:center}
.score-axis text{height:42rpx;display:flex;align-items:center;justify-content:center;line-height:1}
.side-score-chip,.daylight-score-row>view:nth-child(2)>view{height:42rpx;min-height:42rpx;padding:0 6rpx;display:flex;align-items:center;justify-content:center;line-height:1}
.side-score-chip .mini,.daylight-score-row>view:nth-child(2)>view>text:nth-child(2){margin:-9rpx 0 0 2rpx;line-height:1}
.game-score,.daylight-score-row>text:last-child{min-height:42rpx;padding:0 4rpx;display:flex;align-items:center;justify-content:center;line-height:1}
.daylight-score-player-cell>text:first-child{color:#233028;font-size:19rpx}
.daylight-score-row.winner .daylight-score-player-cell>text:first-child{font-weight:750}
@media(max-width:350px){.score-player-cell,.daylight-score-player-cell{gap:5rpx}.score-server-badge,.daylight-score-server{min-width:36rpx;height:25rpx;padding:0 6rpx;font-size:12rpx}.side-score-chip,.score-axis text,.daylight-score-row>view:nth-child(2)>view,.game-score,.daylight-score-row>text:last-child{height:38rpx;min-height:38rpx}}

/* Final dark-mode pass for the detail shell and module tabs. */
.detail-page.theme-dark{background:var(--canvas);color:var(--ink)}
.theme-dark .detail-head{background:rgba(17,24,39,.98);border-color:var(--line);box-shadow:none}
.theme-dark .head-title,
.theme-dark .head-title>text:first-child{color:var(--ink-strong)}
.theme-dark .head-subtitle{color:var(--ink-subtle)}
.theme-dark .head-action{background:var(--surface-subtle);border-color:var(--line-strong)}
.theme-dark .score-hero{background:linear-gradient(180deg,var(--brand-wash) 0%,var(--surface) 62%);border-color:var(--line)}
.theme-dark .match-modules{background:var(--canvas-subtle);border-color:var(--line)}
.theme-dark .module-tabs{background:rgba(17,24,39,.98);border-color:var(--line)}
.theme-dark .module-tabs-inner .tab{color:var(--ink-subtle)}
.theme-dark .module-tabs-inner .tab.active{background:var(--brand-soft);color:var(--brand-ink)}
.theme-dark .module-card{background:var(--surface);color:var(--ink)}
.theme-dark .point-set-tabs{background:var(--surface-subtle);border-color:var(--line)}
.theme-dark .point-set-tabs button.active{background:var(--surface);color:var(--brand-strong)}
.theme-dark .detail-actions{background:var(--canvas-subtle)}
.theme-dark .share-button{background:var(--surface)!important;color:var(--brand-strong)!important}
.hero-name-wrap{align-items:baseline;gap:2rpx}.hero-flower-total{padding:0;border:0;background:transparent}
