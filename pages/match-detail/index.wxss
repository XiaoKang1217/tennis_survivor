.daylight-detail-actions>button{min-width:0;min-height:74rpx;display:flex;align-items:center;justify-content:center;gap:8rpx;border:1rpx solid #d8d5c8;border-radius:14rpx;background:#fffdf7;color:#54775e;font-size:21rpx;font-weight:700;box-sizing:border-box}
