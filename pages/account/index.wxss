.account-page {
  padding-bottom: calc(138rpx + env(safe-area-inset-bottom));
  background: var(--canvas);
}

.account-content {
  min-height: calc(100vh - 138rpx - env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.account-card {
  min-height: 116rpx;
  margin: 24rpx 22rpx 18rpx;
  padding: 24rpx 26rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  border: 1rpx solid var(--line);
  border-radius: 24rpx;
  background: var(--surface);
  box-sizing: border-box;
}

.account-avatar {
  width: 82rpx;
  height: 82rpx;
  flex: 0 0 82rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--brand-soft);
  overflow: hidden;
}

.account-avatar image {
  width: 100%;
  height: 100%;
}

.account-copy {
  min-width: 0;
  flex: 1;
  display: flex;
  flex-direction: column;
}

.account-title {
  overflow: hidden;
  color: var(--ink);
  font-size: 31rpx;
  font-weight: 750;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.account-action {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  gap: 6rpx;
  color: var(--brand-strong);
  font-size: 22rpx;
  font-weight: 650;
}

.account-auth-button {
  height: 88rpx;
  margin: 0 22rpx 24rpx;
  padding: 0;
  border: 0;
  border-radius: 18rpx;
  background: var(--brand-strong);
  color: #fff;
  font-size: 27rpx;
  font-weight: 760;
  line-height: 88rpx;
}

.account-auth-button.is-logout {
  width: calc(100% - 44rpx);
  margin-top: auto;
  margin-bottom: 24rpx;
  border: 1rpx solid var(--line-strong);
  background: var(--surface);
  color: var(--danger);
  box-sizing: border-box;
}

.social-summary-card{margin:0 22rpx 18rpx;padding:22rpx;border:1rpx solid var(--line);border-radius:24rpx;background:var(--surface)}
.social-summary-head{display:flex;align-items:center;justify-content:space-between;gap:18rpx}.social-summary-head>view:first-child{display:flex;flex-direction:column}.social-summary-head>view:first-child text:first-child{color:var(--ink-subtle);font-size:20rpx}.social-summary-head>view:first-child text:last-child{margin-top:4rpx;color:var(--ink);font-size:38rpx;font-weight:800}.social-summary-head>view:last-child{display:flex;align-items:center;gap:5rpx;color:var(--ink-subtle);font-size:19rpx}.checkin-week{margin-top:18rpx;display:grid;grid-template-columns:repeat(7,1fr);gap:7rpx}.checkin-week>view{height:62rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;border-radius:12rpx;background:var(--canvas-subtle);color:var(--ink-muted);font-size:17rpx}.checkin-week>view.checked{background:var(--brand-soft);color:var(--brand-strong)}.checkin-button{height:68rpx;margin-top:16rpx;border:0;border-radius:14rpx;background:var(--brand-strong);color:#fff;font-size:23rpx;font-weight:750;line-height:68rpx}.checkin-button[disabled]{background:var(--surface-subtle);color:var(--ink-muted)}

.settings-card {
  margin: 0 22rpx;
  overflow: hidden;
  border: 1rpx solid var(--line);
  border-radius: 24rpx;
  background: var(--surface);
}

.settings-card > view {
  min-height: 100rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid var(--surface-subtle);
}

.settings-card > view:last-child {
  border-bottom: 0;
}

.settings-card text:first-child {
  color: var(--ink);
  font-size: 25rpx;
  font-weight: 650;
}

.settings-card .setting-value {
  flex: none;
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.settings-card .setting-value text {
  color: var(--ink-subtle);
  font-size: 22rpx;
}

.account-page.theme-daylight {
  padding-bottom: calc(126rpx + env(safe-area-inset-bottom));
  background: #f5f1e6;
}

.account-page.theme-daylight .account-content {
  min-height: calc(100vh - 126rpx - env(safe-area-inset-bottom));
}

.daylight-account-content {
  padding: 24rpx 24rpx 70rpx;
}

.daylight-profile-card {
  padding: 24rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.daylight-account-avatar {
  width: 84rpx;
  height: 84rpx;
  flex: 0 0 84rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #f8ead9;
  overflow: hidden;
}

.daylight-account-avatar image {
  width: 100%;
  height: 100%;
}

.daylight-profile-copy {
  min-width: 0;
  flex: 1;
}

.daylight-profile-name {
  overflow: hidden;
  color: #233028;
  font-size: 30rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.daylight-profile-action {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  gap: 6rpx;
  color: #54775e;
  font-size: 20rpx;
  font-weight: 650;
}

.daylight-auth-button {
  height: 86rpx;
  margin: 18rpx 0 0;
  padding: 0;
  border: 0;
  border-radius: 16rpx;
  background: #54775e;
  color: #fff;
  font-size: 26rpx;
  font-weight: 760;
  line-height: 86rpx;
}

.daylight-auth-button.is-logout {
  border: 1rpx solid #d8d5c8;
  background: #fffdf7;
  color: #b6533d;
}

.daylight-settings-group {
  margin-top: 30rpx;
}

.daylight-settings > view {
  min-height: 106rpx;
  padding: 0 22rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  border-bottom: 1rpx solid #ece8dd;
}

.daylight-settings > view:last-child {
  border-bottom: 0;
}

.daylight-settings > view > view:first-child {
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.daylight-settings > view > view:first-child text:first-child {
  color: #233028;
  font-size: 24rpx;
  font-weight: 650;
}

.daylight-setting-value {
  flex: none;
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: #54775e;
  font-size: 20rpx;
}

.theme-sheet-layer {
  position: fixed;
  z-index: 80;
  inset: 0;
}

.theme-sheet-mask {
  position: absolute;
  inset: 0;
  background: rgba(23, 31, 26, .38);
}

.theme-sheet {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 12rpx 24rpx calc(28rpx + env(safe-area-inset-bottom));
  border-radius: 36rpx 36rpx 0 0;
  background: var(--surface, #fff);
  box-shadow: 0 -18rpx 60rpx rgba(20, 34, 26, .16);
}

.theme-sheet-handle {
  width: 72rpx;
  height: 7rpx;
  margin: 0 auto 22rpx;
  border-radius: 999rpx;
  background: var(--line, #d8d5c8);
}

.theme-sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.theme-sheet-head > view:first-child {
  display: flex;
  flex-direction: column;
  gap: 5rpx;
}

.theme-sheet-head > view:first-child text:first-child {
  color: var(--ink, #1a1c1f);
  font-size: 30rpx;
  font-weight: 750;
}

.theme-sheet-head > view:first-child text:last-child {
  color: var(--ink-subtle, #66788a);
  font-size: 20rpx;
}

.theme-sheet-head > view:last-child {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.theme-options {
  margin-top: 22rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.theme-option {
  min-height: 126rpx;
  padding: 16rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
  border: 2rpx solid var(--line, #e5edf5);
  border-radius: 18rpx;
  background: var(--surface-subtle, #f7fafc);
  box-sizing: border-box;
}

.theme-option.selected {
  border-color: var(--brand-strong, #1677d2);
  background: var(--brand-soft, #e5f2ff);
}

.theme-preview {
  width: 108rpx;
  height: 88rpx;
  flex: 0 0 108rpx;
  padding: 10rpx;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  border-radius: 12rpx;
  box-sizing: border-box;
  overflow: hidden;
}

.preview-clean-blue {
  background: var(--canvas);
}

.preview-daylight {
  background: #f5f1e6;
}

.preview-dark {
  background: #07111f;
}

.theme-preview view {
  height: 12rpx;
  border-radius: 3rpx;
  background: var(--surface);
}

.preview-clean-blue view:first-child {
  width: 70%;
  background: var(--brand);
}

.preview-daylight view:first-child {
  width: 70%;
  background: #54775e;
}

.preview-daylight view:nth-child(2) {
  background: #fffdf7;
}

.preview-daylight view:nth-child(3) {
  width: 82%;
  background: #d88b62;
}

.preview-dark view:first-child {
  width: 70%;
  background: #38bdf8;
}

.preview-dark view:nth-child(2) {
  background: var(--ink-strong);
}

.preview-dark view:nth-child(3) {
  width: 82%;
  background: #33465c;
}

.theme-option-copy {
  min-width: 0;
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 5rpx;
}

.theme-option-copy text:first-child {
  color: var(--ink, #1a1c1f);
  font-size: 25rpx;
  font-weight: 700;
}

.theme-option-copy text:last-child {
  color: var(--ink-subtle, #66788a);
  font-size: 19rpx;
  line-height: 1.35;
}

.theme-check {
  width: 36rpx;
  flex: 0 0 36rpx;
  color: var(--brand-strong, #1677d2);
  font-size: 28rpx;
  font-weight: 800;
  text-align: center;
}

.flower-emoji{display:inline-flex;align-items:center;justify-content:center;line-height:1}.flower-emoji-balance{margin-right:4rpx;font-size:25rpx}.flower-emoji-small{width:20rpx;height:20rpx;font-size:16rpx;line-height:20rpx;text-align:center}
