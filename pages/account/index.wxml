<page-meta page-style="{{themePageStyle}}" background-color="{{themeCanvas}}" background-text-style="{{themeBackgroundTextStyle}}"/>
<view class="safe-page account-page theme-{{uiTheme}}">
  <view class="account-content" style="padding-top:{{topInset}}px">
    <view class="account-card" bindtap="openProfileGate" role="button"><view class="account-avatar"><image wx:if="{{profile.avatarUrl}}" src="{{profile.avatarUrl}}" mode="aspectFill" lazy-load="{{true}}"/><ui-icon wx:else name="profile" size="28" color="#1677d2"/></view><view class="account-copy"><text class="account-title">{{profile.nickname}}</text></view><view class="account-action"><text>{{profile.actionLabel}}</text><ui-icon name="chevron" size="14" color="#1677d2"/></view></view>
    <view wx:if="{{socialReady}}" class="social-summary-card">
      <view class="social-summary-head" bindtap="openSocialCenter" role="button"><view><text>我的花朵</text><view><text class="flower-emoji flower-emoji-balance">🌸</text><text>{{wallet.balance}}</text></view></view><view><text>累计签到 {{checkins.totalDays}} 天 · 连续 {{checkins.currentStreak}} 天</text><ui-icon name="chevron" size="14" color="{{themeAccentStrong}}"/></view></view>
      <view class="checkin-week"><view wx:for="{{checkins.recentSevenDays}}" wx:key="date" class="{{item.checkedIn ? 'checked' : ''}}"><text>{{item.dayLabel}}</text><text wx:if="{{item.checkedIn}}" class="flower-emoji flower-emoji-small">🌸</text><text wx:else>·</text></view></view>
      <button class="checkin-button" bindtap="checkin" disabled="{{checkins.checkedInToday}}">{{checkins.checkedInToday ? '今日已签到' : '签到领 1 朵花'}}</button>
    </view>
    <button wx:if="{{!profile.completed}}" class="account-auth-button" bindtap="toggleLogin">{{profile.authActionLabel}}</button>
    <view class="settings-card"><view bindtap="openSocialCenter" role="button"><text>签到、花朵与勋章</text><view class="setting-value"><text>查看</text><ui-icon name="chevron" size="14" color="{{themeAccentStrong}}"/></view></view><view bindtap="openThemeSheet" role="button"><text>界面主题</text><view class="setting-value"><text>{{themeLabel}}</text><ui-icon name="chevron" size="14" color="{{themeAccentStrong}}"/></view></view><view bindtap="openTerms" role="button"><text>用户协议</text><view class="setting-value"><text>查看</text><ui-icon name="chevron" size="14" color="{{themeAccentStrong}}"/></view></view><view bindtap="openPrivacyPolicy" role="button"><text>隐私政策</text><view class="setting-value"><text>查看</text><ui-icon name="chevron" size="14" color="{{themeAccentStrong}}"/></view></view></view>
    <button wx:if="{{profile.completed}}" class="account-auth-button is-logout" bindtap="toggleLogin">{{profile.authActionLabel}}</button>
  </view>

  <view wx:if="{{themeSheetOpen}}" class="theme-sheet-layer" catchtouchmove="noop"><view class="theme-sheet-mask" bindtap="closeThemeSheet"/><view class="theme-sheet"><view class="theme-sheet-handle"/><view class="theme-sheet-head"><view><text>选择界面主题</text><text>选择你喜欢的界面配色</text></view><view bindtap="closeThemeSheet" role="button"><ui-icon name="close" size="18" color="{{themeMuted}}"/></view></view><view class="theme-options"><view wx:for="{{themeOptions}}" wx:key="id" class="theme-option {{uiTheme === item.id ? 'selected' : ''}}" data-theme="{{item.id}}" bindtap="chooseTheme" role="button"><view class="theme-preview preview-{{item.id}}"><view/><view/><view/></view><view class="theme-option-copy"><text>{{item.label}}</text><text>{{item.description}}</text></view><view class="theme-check"><ui-icon wx:if="{{uiTheme === item.id}}" name="check" size="16" color="{{item.id === 'daylight' ? '#54775e' : themeAccentStrong}}"/></view></view></view></view></view>
  <product-tabbar active="account" theme="{{uiTheme}}"/>
  <profile-gate id="profileGate" theme="{{uiTheme}}"/>
</view>
