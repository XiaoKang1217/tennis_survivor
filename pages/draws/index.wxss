.draw-page{
  min-height:100vh;
  padding-bottom:calc(138rpx + env(safe-area-inset-bottom));
  overflow-x:hidden;
  background:var(--canvas);
}
.page-head{
  background:var(--surface);
  border-bottom:1rpx solid var(--line);
}
.module-nav{
  width:100%;
  min-height:76rpx;
  display:flex;
  background:var(--surface);
  box-sizing:border-box;
}
.module{
  position:relative;
  flex:1 1 25%;
  width:25%;
  min-width:0;
  min-height:76rpx;
  padding:6rpx 3rpx 12rpx;
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  gap:5rpx;
  color:var(--ink-subtle);
  font-size:22rpx;
  white-space:nowrap;
  box-sizing:border-box;
}
.module.active{
  color:var(--brand-strong);
  font-weight:650;
}
.module.active::after{
  content:'';
  position:absolute;
  left:24rpx;
  right:24rpx;
  bottom:0;
  height:4rpx;
  border-radius:4rpx;
  background:var(--brand);
}
.draw-summary{
  margin:10rpx 16rpx 0;
  padding:12rpx 16rpx;
  display:grid;
  grid-template-columns:minmax(0,1fr) auto;
  align-items:center;
  gap:10rpx;
  border:1rpx solid var(--line);
  border-radius:18rpx;
  background:var(--surface);
  box-shadow:0 10rpx 26rpx rgba(21,55,96,.06);
}
.summary-copy{
  min-width:0;
  display:flex;
  flex-direction:column;
  gap:7rpx;
}
.summary-main-row{
  min-width:0;
  display:flex;
  align-items:center;
  justify-content:flex-start;
  gap:10rpx;
}
.summary-title{
  min-width:0;
  flex:0 1 auto;
  overflow-wrap:anywhere;
  color:var(--ink);
  font-size:28rpx;
  line-height:1.22;
  font-weight:800;
}
.summary-tags{
  flex:none;
  display:flex;
  align-items:center;
  gap:6rpx;
}
.summary-tags text{
  padding:4rpx 9rpx;
  border:1rpx solid var(--line-strong);
  border-radius:10rpx;
  background:var(--brand-soft);
  color:var(--brand-strong);
  font-size:17rpx;
  line-height:1.25;
  font-weight:750;
  white-space:nowrap;
}
.summary-date{
  color:var(--ink-subtle);
  font-size:18rpx;
  line-height:1.3;
}
.summary-actions{
  display:flex;
  flex-direction:column;
  align-items:flex-end;
  gap:8rpx;
}
.summary-actions button,
.draw-toolbar button,
.selector-head button,
.selector-period button,
.focus-chip button{
  margin:0;
}
.summary-actions button::after,
.draw-toolbar button::after,
.selector-head button::after,
.selector-period button::after,
.focus-chip button::after,
.choice-row button::after,
.draw-tab-row button::after,
.round-tabs button::after,
.round-match-card::after{
  border:0;
}
.summary-actions button{
  width:154rpx;
  height:52rpx;
  min-height:52rpx;
  padding:0 16rpx;
  display:flex;
  align-items:center;
  justify-content:center;
  gap:7rpx;
  border:1rpx solid var(--line-strong);
  border-radius:14rpx;
  background:transparent;
  color:var(--brand-strong);
  font-size:20rpx;
  font-weight:750;
  line-height:normal;
  white-space:nowrap;
  box-sizing:border-box;
}
.summary-actions button[disabled]{
  color:var(--ink-subtle);
  opacity:.62;
}
.summary-actions .detail-link{
  width:154rpx;
  height:52rpx;
  min-height:52rpx;
  padding:0 16rpx;
  border:1rpx solid var(--brand);
  border-radius:14rpx;
  background:var(--surface);
  color:var(--brand-strong);
  font-size:20rpx;
}
.summary-actions .primary{
  width:154rpx;
  min-width:154rpx;
  height:52rpx;
  min-height:52rpx;
  padding:0 20rpx;
  border-color:var(--brand);
  background:var(--brand);
  color:#fff;
}
.draw-selectors{
  margin-top:8rpx;
  padding:8rpx 16rpx 10rpx;
  display:flex;
  flex-direction:column;
  gap:7rpx;
  border-top:1rpx solid var(--line);
  border-bottom:1rpx solid var(--line);
  background:var(--surface);
}
.selector-block{
  display:grid;
  grid-template-columns:48rpx minmax(0,1fr);
  align-items:center;
  gap:8rpx;
}
.selector-block>text{
  color:var(--ink-subtle);
  font-size:20rpx;
}
.choice-scroll{
  min-width:0;
  white-space:nowrap;
}
.choice-row{
  min-width:0;
  display:inline-flex;
  gap:7rpx;
  padding-right:16rpx;
  box-sizing:border-box;
}
.choice-row button,
.round-tabs button{
  width:auto;
  min-width:104rpx;
  flex:none;
  height:50rpx;
  min-height:50rpx;
  margin:0;
  padding:0 18rpx;
  display:inline-flex;
  align-items:center;
  justify-content:center;
  border:1rpx solid var(--line);
  border-radius:12rpx;
  background:var(--surface-subtle);
  color:var(--ink-muted);
  font-size:21rpx;
  line-height:normal;
  white-space:nowrap;
  box-sizing:border-box;
}
.choice-row button.selected,
.round-tabs button.selected{
  border-color:var(--brand);
  background:var(--brand);
  color:#fff;
  font-weight:760;
}
.draw-tab-row{
  width:100%;
  min-height:58rpx;
  padding:3rpx;
  display:flex;
  align-items:center;
  justify-content:stretch;
  gap:7rpx;
  border-radius:14rpx;
  background:transparent;
}
.draw-tab-row button{
  width:0;
  min-width:0;
  flex:1 1 0;
  height:52rpx;
  min-height:52rpx;
  margin:0;
  padding:0 6rpx;
  display:flex;
  align-items:center;
  justify-content:center;
  border:1rpx solid var(--line);
  border-radius:12rpx;
  background:var(--surface-subtle);
  color:var(--ink-muted);
  font-size:20rpx;
  line-height:normal;
  white-space:nowrap;
  box-sizing:border-box;
}
.draw-tab-row button.selected{
  border-color:var(--brand);
  background:var(--brand);
  color:#fff;
  font-weight:800;
  box-shadow:0 5rpx 16rpx rgba(21,55,96,.08);
}
.page-state{
  padding:62rpx 24rpx 0;
}
.draw-content{
  padding:10rpx 16rpx 40rpx;
}
.draw-column{
  display:flex;
  flex-direction:column;
  gap:8rpx;
}
.draw-toolbar{
  display:block;
  align-items:center;
}
.player-search{
  min-width:0;
  min-height:52rpx;
  padding:0 14rpx;
  display:flex;
  align-items:center;
  gap:10rpx;
  border:1rpx solid var(--line);
  border-radius:14rpx;
  background:var(--surface);
  box-sizing:border-box;
}
.player-search input{
  min-width:0;
  height:50rpx;
  flex:1;
  color:var(--ink);
  font-size:22rpx;
}
.draw-toolbar button{
  min-height:58rpx;
  padding:0 14rpx;
  display:flex;
  align-items:center;
  justify-content:center;
  gap:7rpx;
  border:1rpx solid var(--line);
  border-radius:18rpx;
  background:var(--surface);
  color:var(--brand-strong);
  font-size:20rpx;
  font-weight:760;
  line-height:1.2;
  white-space:nowrap;
}
.player-results,
.focus-chip,
.round-heading,
.draw-facts-card{
  border:1rpx solid var(--line);
  border-radius:22rpx;
  background:var(--surface);
}
.player-results{
  padding:8rpx 12rpx;
}
.player-results>view{
  min-height:58rpx;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:16rpx;
  border-bottom:1rpx solid var(--surface-subtle);
}
.player-results>view:last-child{
  border-bottom:0;
}
.player-results text:first-child{
  min-width:0;
  overflow:hidden;
  color:var(--ink);
  font-size:22rpx;
  font-weight:700;
  text-overflow:ellipsis;
  white-space:nowrap;
}
.player-results text:last-child{
  color:var(--ink-subtle);
  font-size:18rpx;
  white-space:nowrap;
}
.focus-chip{
  min-height:0;
  padding:10rpx 12rpx;
  display:flex;
  flex-direction:column;
  align-items:stretch;
  gap:8rpx;
  position:sticky;
  z-index:12;
  box-shadow:0 8rpx 24rpx rgba(21,55,96,.12);
}
.focus-chip>view:first-child{
  width:100%;
  min-width:0;
  display:flex;
  flex-direction:row;
  align-items:center;
  justify-content:space-between;
  gap:10rpx;
  box-sizing:border-box;
}
.focus-chip>view:first-child text:first-child{
  min-width:0;
  overflow:hidden;
  color:var(--brand-strong);
  font-size:22rpx;
  font-weight:800;
  text-overflow:ellipsis;
  white-space:nowrap;
}
.focus-chip>view:first-child text:last-child{
  flex:none;
  color:var(--ink-subtle);
  font-size:17rpx;
  white-space:nowrap;
}
.focus-actions{
  width:100%;
  display:grid;
  grid-template-columns:repeat(3,minmax(0,1fr));
  gap:5rpx;
}
.focus-chip button{
  width:100%;
  min-width:0;
  min-height:40rpx;
  padding:0 6rpx;
  border:0;
  border-radius:12rpx;
  background:var(--brand-soft);
  color:var(--brand-strong);
  font-size:17rpx;
}
.focus-chip button[disabled]{
  opacity:.45;
}
.round-scroll{
  width:100%;
  white-space:nowrap;
}
.round-tabs{
  display:inline-flex;
  min-width:100%;
  gap:6rpx;
  padding-right:0;
  box-sizing:border-box;
}
.round-tabs button{
  flex:1 0 auto;
}
.round-tabs button.has-focus{
  box-shadow:inset 0 -5rpx 0 var(--warning);
}
.round-heading{
  min-height:34rpx;
  padding:0 4rpx;
  display:flex;
  align-items:center;
  justify-content:flex-end;
  border:0;
  border-radius:0;
  background:transparent;
}
.round-count{
  color:var(--ink-subtle);
  font-size:18rpx;
  font-weight:650;
}
.round-match-list{
  width:100%;
  display:flex;
  flex-direction:column;
  align-items:stretch;
  gap:10rpx;
  box-sizing:border-box;
}
.round-match-card{
  width:100%;
  min-width:100%;
  max-width:none;
  align-self:stretch;
  margin:0;
  padding:0;
  overflow:hidden;
  border:1rpx solid var(--line);
  border-radius:16rpx;
  background:var(--surface);
  box-shadow:0 6rpx 18rpx rgba(21,55,96,.05);
  text-align:left;
  box-sizing:border-box;
}
.round-match-card.focused{
  border:3rpx solid var(--brand);
  background:var(--brand-wash);
  box-shadow:0 0 0 5rpx var(--brand-soft),0 12rpx 30rpx rgba(21,55,96,.12);
}
.round-match-card.static{
  opacity:.96;
}
.match-card-head{
  min-height:38rpx;
  padding:0 12rpx 0 16rpx;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:12rpx;
  border-bottom:1rpx solid var(--line);
  background:var(--surface-subtle);
  box-sizing:border-box;
}
.match-card-head>text:first-child{
  color:var(--ink-subtle);
  font-size:18rpx;
  font-weight:760;
}
.status-pill{
  max-width:180rpx;
  padding:5rpx 10rpx;
  overflow:hidden;
  border-radius:11rpx;
  background:var(--brand-soft);
  color:var(--brand-strong);
  font-size:18rpx;
  font-weight:800;
  line-height:1.15;
  text-overflow:ellipsis;
  white-space:nowrap;
}
.match-card-state{
  flex:none;
  display:flex;
  align-items:center;
  gap:6rpx;
}
.located-pill{
  padding:5rpx 10rpx;
  border-radius:11rpx;
  background:var(--brand);
  color:#fff;
  font-size:17rpx;
  font-weight:820;
  line-height:1.15;
}
.match-side{
  position:relative;
  min-height:68rpx;
  padding:9rpx 12rpx 9rpx 18rpx;
  display:grid;
  grid-template-columns:minmax(0,1fr) auto;
  align-items:center;
  gap:8rpx;
  border-bottom:1rpx solid var(--surface-subtle);
  box-sizing:border-box;
}
.match-side:last-of-type{
  border-bottom:0;
}
.match-side.winner::before{
  content:'';
  position:absolute;
  left:0;
  top:10rpx;
  bottom:10rpx;
  width:6rpx;
  border-radius:0 6rpx 6rpx 0;
  background:var(--brand);
}
.match-side.focused-side{
  background:var(--brand-wash);
}
.side-copy{
  min-width:0;
  display:flex;
  flex-direction:column;
  gap:2rpx;
}
.identity-tag,
.winner-label{
  flex:none;
  font-size:15rpx;
  line-height:1.2;
  white-space:nowrap;
}
.identity-tag{
  color:var(--brand-strong);
  font-weight:760;
}
.winner-label{
  padding:2rpx 6rpx;
  border-radius:8rpx;
  background:var(--brand);
  color:#fff;
  font-weight:800;
}
.member-list{
  min-width:0;
  display:flex;
  flex-direction:column;
  gap:2rpx;
}
.member-list>view{
  min-width:0;
  display:flex;
  align-items:center;
  gap:6rpx;
  overflow:hidden;
}
.country{
  flex:none;
  color:var(--ink-subtle);
  font-size:18rpx;
}
.member-name{
  min-width:0;
  max-width:100%;
  overflow:hidden;
  color:var(--ink);
  font-size:25rpx;
  line-height:1.26;
  font-weight:720;
  text-overflow:ellipsis;
  white-space:nowrap;
  word-break:keep-all;
}
.match-side.winner .member-name{
  color:var(--ink-strong);
  font-weight:820;
}
.score-grid{
  flex:none;
  display:flex;
  align-items:center;
  justify-content:flex-end;
  gap:3rpx;
  font-variant-numeric:tabular-nums;
}
.score-grid>text{
  position:relative;
  min-width:32rpx;
  min-height:36rpx;
  display:flex;
  align-items:center;
  justify-content:center;
  border-radius:8rpx;
  background:var(--surface-subtle);
  color:var(--ink);
  font-size:21rpx;
  font-weight:800;
}
.tiebreak{
  position:absolute;
  right:3rpx;
  top:2rpx;
  color:var(--ink-subtle);
  font-size:11rpx;
  line-height:1;
}
.match-foot{
  min-height:42rpx;
  padding:8rpx 14rpx;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:14rpx;
  border-top:1rpx solid var(--line);
  background:var(--surface-subtle);
}
.match-foot text{
  min-width:0;
  overflow:hidden;
  color:var(--ink-subtle);
  font-size:18rpx;
  text-overflow:ellipsis;
  white-space:nowrap;
}
.match-foot .status{
  flex:none;
  padding:5rpx 9rpx;
  border-radius:10rpx;
  background:var(--brand-soft);
  color:var(--brand-strong);
  font-weight:760;
}
.draw-facts-card{
  padding:22rpx;
}
.facts-head{
  display:flex;
  align-items:flex-end;
  justify-content:space-between;
  gap:16rpx;
  margin-bottom:16rpx;
}
.facts-head text:first-child{
  color:var(--ink);
  font-size:28rpx;
  font-weight:800;
}
.facts-head text:last-child{
  color:var(--ink-subtle);
  font-size:19rpx;
  text-align:right;
}
.award-table{
  overflow:hidden;
  border:1rpx solid var(--line);
  border-radius:16rpx;
}
.award-header,
.award-row{
  min-height:62rpx;
  display:grid;
  grid-template-columns:1.15fr 1fr .75fr;
  align-items:center;
  gap:10rpx;
  padding:0 14rpx;
  border-bottom:1rpx solid var(--line);
}
.award-header{
  background:var(--surface-subtle);
  color:var(--ink-subtle);
  font-size:18rpx;
  font-weight:760;
}
.award-row:last-child{
  border-bottom:0;
}
.award-row text{
  min-width:0;
  overflow-wrap:anywhere;
  color:var(--ink);
  font-size:20rpx;
}
.award-row text:nth-child(2),
.award-row text:nth-child(3){
  text-align:right;
}
.basis{
  color:var(--ink-subtle)!important;
  font-size:17rpx!important;
}
.record-list{
  display:flex;
  flex-direction:column;
  border-top:1rpx solid var(--line);
}
.record-row{
  min-height:72rpx;
  padding:12rpx 0;
  display:flex;
  flex-direction:column;
  gap:5rpx;
  border-bottom:1rpx solid var(--line);
}
.record-row:last-child{
  border-bottom:0;
}
.record-row text:first-child{
  color:var(--ink);
  font-size:22rpx;
  font-weight:760;
}
.record-row text:not(:first-child){
  color:var(--ink-subtle);
  font-size:19rpx;
}
.selector-mask{
  position:fixed;
  left:0;
  right:0;
  top:0;
  bottom:0;
  z-index:60;
  display:flex;
  align-items:flex-end;
  background:rgba(7,17,31,.45);
}
.selector-panel{
  width:100%;
  max-height:82vh;
  padding:20rpx 20rpx calc(24rpx + env(safe-area-inset-bottom));
  overflow:hidden;
  border-radius:28rpx 28rpx 0 0;
  background:var(--surface);
  box-sizing:border-box;
}
.selector-head{
  min-height:62rpx;
  display:flex;
  align-items:center;
  justify-content:space-between;
}
.selector-head text{
  color:var(--ink);
  font-size:30rpx;
  font-weight:820;
}
.selector-head button,
.selector-period button{
  min-height:52rpx;
  padding:0 16rpx;
  border:1rpx solid var(--line);
  border-radius:14rpx;
  background:var(--surface-subtle);
  color:var(--brand-strong);
  font-size:20rpx;
  font-weight:760;
}
.selector-period{
  min-height:62rpx;
  display:grid;
  grid-template-columns:auto minmax(0,1fr) auto;
  align-items:center;
  gap:12rpx;
  color:var(--ink-subtle);
  font-size:20rpx;
}
.selector-period text:first-child{
  color:var(--ink);
  font-weight:760;
}
.tour-filter{
  margin-top:10rpx;
  padding:5rpx;
  display:grid;
  grid-template-columns:repeat(5,minmax(0,1fr));
  gap:4rpx;
  border:1rpx solid var(--line);
  border-radius:18rpx;
  background:var(--surface-subtle);
}
.tour-filter>view{
  min-width:0;
  min-height:54rpx;
  display:flex;
  align-items:center;
  justify-content:center;
  border-radius:13rpx;
  color:var(--ink-muted);
  font-size:18rpx;
  white-space:nowrap;
}
.tour-filter>view.selected{
  background:var(--surface);
  color:var(--brand-strong);
  font-weight:820;
  box-shadow:0 4rpx 14rpx rgba(21,55,96,.08);
}
.event-search{
  min-height:66rpx;
  margin-top:12rpx;
  padding:0 16rpx;
  display:flex;
  align-items:center;
  gap:10rpx;
  border:1rpx solid var(--line);
  border-radius:18rpx;
  background:var(--surface-subtle);
  box-sizing:border-box;
}
.event-search input{
  min-width:0;
  height:64rpx;
  flex:1;
  color:var(--ink);
  font-size:22rpx;
}
.event-list{
  max-height:48vh;
  margin-top:12rpx;
}
.event-row{
  min-height:88rpx;
  padding:13rpx 14rpx;
  display:flex;
  flex-direction:column;
  justify-content:center;
  border:1rpx solid var(--line);
  border-radius:18rpx;
  background:var(--surface);
  box-sizing:border-box;
}
.event-row+.event-row{
  margin-top:10rpx;
}
.event-row.selected{
  border-color:var(--brand);
  background:var(--brand-soft);
}
.event-row text:first-child{
  overflow:hidden;
  color:var(--ink);
  font-size:22rpx;
  font-weight:760;
  text-overflow:ellipsis;
  white-space:nowrap;
}
.event-row text:last-child{
  margin-top:5rpx;
  overflow:hidden;
  color:var(--ink-subtle);
  font-size:18rpx;
  text-overflow:ellipsis;
  white-space:nowrap;
}
.draw-page.theme-daylight{
  background:#f5f1e6;
}
.theme-daylight .page-head,
.theme-daylight .draw-summary,
.theme-daylight .draw-selectors,
.theme-daylight .round-match-card,
.theme-daylight .draw-facts-card,
.theme-daylight .selector-panel,
.theme-daylight .player-search,
.theme-daylight .draw-toolbar button,
.theme-daylight .round-heading,
.theme-daylight .player-results,
.theme-daylight .focus-chip{
  border-color:#d8d5c8;
  background:#fffdf7;
}
.theme-daylight .choice-row button,
.theme-daylight .round-tabs button,
.theme-daylight .event-search,
.theme-daylight .tour-filter,
.theme-daylight .draw-tab-row,
.theme-daylight .match-foot,
.theme-daylight .score-grid>text{
  background:#f9f6eb;
}
.theme-daylight .choice-row button.selected,
.theme-daylight .round-tabs button.selected,
.theme-daylight .summary-actions .primary,
.theme-daylight .summary-tags text{
  border-color:#54775e;
  background:#54775e;
  color:#fff;
}
.theme-daylight .draw-tab-row button.selected,
.theme-daylight .tour-filter>view.selected,
.theme-daylight .event-row.selected{
  background:#e6eee3;
  color:#40634b;
}
.theme-daylight .entry,
.theme-daylight .match-foot .status,
.theme-daylight .round-heading>text,
.theme-daylight .focus-chip button{
  background:#e6eee3;
  color:#54775e;
}
.theme-daylight .match-side.winner::before{
  background:#54775e;
}
.theme-dark .selector-mask{
  background:rgba(0,0,0,.62);
}
@media(max-width:340px){
  .draw-summary,
  .draw-content,
  .draw-selectors,
  .selector-panel{
    margin-left:12rpx;
    margin-right:12rpx;
    padding-left:14rpx;
    padding-right:14rpx;
  }
  .draw-content{
    padding-left:12rpx;
    padding-right:12rpx;
  }
  .draw-toolbar{
    grid-template-columns:1fr;
  }
  .member-name{
    font-size:22rpx;
  }
  .score-grid>text{
    min-width:30rpx;
    min-height:38rpx;
    font-size:20rpx;
  }
  .tour-filter{
    grid-template-columns:repeat(3,minmax(0,1fr));
  }
}
