<view class="safe-page participation-page theme-{{uiTheme}}">
  <block wx:if="{{isDaylight}}">
    <view class="daylight-brand-head" style="padding-top:{{topInset + 8}}px">
      <text class="daylight-kicker">参赛动态</text>
      <text class="daylight-page-title">参赛动态</text>
      <text class="daylight-caption">退赛、替补与名单变化</text>
    </view>
    <view class="daylight-module-nav">
      <button bindtap="openScores" aria-label="比分"><text>比分</text></button>
      <button bindtap="openDraws" aria-label="签表"><text>签表</text></button>
      <button bindtap="openCalendar" aria-label="赛历"><text>赛历</text></button>
      <button class="active" aria-label="动态"><text>动态</text></button>
    </view>
    <view class="daylight-page-state">
      <client-state state="empty" label="{{emptyLabel}}" message="{{emptyMessage}}"/>
    </view>
    <product-tabbar active="matches" theme="{{uiTheme}}"/>
  </block>
  <block wx:else>
    <view class="page-head">
      <view class="title-row" style="padding-top:{{topInset}}px">
        <view class="title-copy">
          <text class="eyebrow">参赛动态</text>
          <text class="title">比赛</text>
          <text class="title-caption">退赛、替补与名单变化</text>
        </view>
      </view>
      <view class="module-nav">
        <view class="module" bindtap="openScores"><ui-icon name="score" size="20"/><text>实时比分</text></view>
        <view class="module" bindtap="openDraws"><ui-icon name="draw" size="20"/><text>赛事签表</text></view>
        <view class="module" bindtap="openCalendar"><ui-icon name="calendar" size="20"/><text>巡回赛历</text></view>
        <view class="module active"><ui-icon name="entry" size="20" color="#1677d2"/><text>参赛动态</text></view>
      </view>
    </view>

    <view class="page-state">
      <client-state state="empty" label="{{emptyLabel}}" message="{{emptyMessage}}"/>
    </view>

    <product-tabbar active="matches" theme="{{uiTheme}}"/>
  </block>
  <profile-gate id="profileGate" theme="{{uiTheme}}"/>
</view>
