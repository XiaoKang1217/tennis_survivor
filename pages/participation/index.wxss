.participation-page{
  min-height:100vh;
  padding-bottom:calc(138rpx + env(safe-area-inset-bottom));
  overflow-x:hidden;
  background:var(--canvas);
}
.page-head{
  background:var(--surface);
  border-bottom:1rpx solid var(--line);
}
.title-row{
  min-height:116rpx;
  padding:12rpx 28rpx 16rpx;
  display:flex;
  align-items:flex-end;
  box-sizing:border-box;
}
.title-copy{
  display:flex;
  flex-direction:column;
  gap:3rpx;
}
.eyebrow{
  color:var(--ink-subtle);
  font-size:24rpx;
  line-height:1.4;
}
.title{
  color:var(--ink);
  font-size:42rpx;
  line-height:1.15;
  font-weight:700;
}
.title-caption{
  color:var(--ink-subtle);
  font-size:23rpx;
  line-height:1.4;
}
.module-nav{
  width:100%;
  min-height:90rpx;
  display:flex;
  border-top:1rpx solid var(--line);
  background:var(--surface);
  box-sizing:border-box;
}
.module{
  position:relative;
  flex:1 1 25%;
  width:25%;
  min-width:0;
  min-height:88rpx;
  padding:8rpx 3rpx 14rpx;
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  gap:5rpx;
  color:var(--ink-subtle);
  font-size:24rpx;
  white-space:nowrap;
  box-sizing:border-box;
}
.module.active{
  color:var(--brand-strong);
  font-weight:650;
}
.module.active::after{
  content:'';
  position:absolute;
  left:24rpx;
  right:24rpx;
  bottom:0;
  height:4rpx;
  border-radius:4rpx;
  background:var(--brand);
}
.page-state{
  padding:62rpx 24rpx 0;
}
.entry-toolbar{padding:20rpx 24rpx 8rpx}
.segmented{height:68rpx;padding:5rpx;display:flex;border:1rpx solid var(--line);border-radius:16rpx;background:var(--surface-muted);box-sizing:border-box}
.segment{flex:1;display:flex;align-items:center;justify-content:center;border-radius:12rpx;color:var(--ink-subtle);font-size:25rpx}
.segment.active{background:var(--surface);color:var(--brand-strong);font-weight:650;box-shadow:0 3rpx 12rpx rgba(34,76,124,.08)}
.source-meta{padding:12rpx 4rpx 0;display:flex;justify-content:space-between;gap:14rpx;color:var(--ink-subtle);font-size:20rpx}
.entry-list{padding:12rpx 24rpx 30rpx;display:flex;flex-direction:column;gap:14rpx}
.entry-card{padding:22rpx;border:1rpx solid var(--line);border-radius:20rpx;background:var(--surface);box-shadow:0 8rpx 24rpx rgba(35,69,112,.05)}
.card-main{display:flex;align-items:center;gap:16rpx}.player-card{display:grid;grid-template-columns:84rpx minmax(0,1fr) auto;align-items:center;gap:16rpx}
.tour-pill{min-width:66rpx;padding:7rpx 10rpx;border-radius:10rpx;background:var(--brand-soft);color:var(--brand-strong);font-size:20rpx;font-weight:700;text-align:center}
.card-copy{min-width:0;flex:1;display:flex;flex-direction:column;gap:5rpx}
.card-title{overflow:hidden;color:var(--ink);font-size:28rpx;font-weight:650;white-space:nowrap;text-overflow:ellipsis}
.card-subtitle{color:var(--ink-subtle);font-size:22rpx}.date-line{color:var(--ink-subtle);font-size:20rpx}.count{color:var(--brand-strong);font-size:23rpx;font-weight:650}
.card-foot{margin-top:18rpx;padding-top:15rpx;display:flex;justify-content:space-between;border-top:1rpx solid var(--line);color:var(--ink-subtle);font-size:22rpx}
.preview-list{margin-top:18rpx;padding-top:10rpx;display:grid;grid-template-columns:1fr 1fr;gap:8rpx 14rpx;border-top:1rpx solid var(--line)}
.preview-row{min-width:0;display:flex;align-items:center;gap:8rpx;padding:6rpx 0}.preview-avatar{width:40rpx;height:40rpx;flex:none;border-radius:50%;background:var(--brand-soft)}.preview-avatar.fallback{display:flex;align-items:center;justify-content:center;color:var(--brand-strong);font-size:17rpx}.preview-name{min-width:0;flex:1;overflow:hidden;color:var(--ink);font-size:20rpx;white-space:nowrap;text-overflow:ellipsis}.status{flex:none;padding:3rpx 7rpx;border-radius:8rpx;background:var(--brand-soft);color:var(--brand-strong);font-size:17rpx}.status-caution{background:var(--surface-muted);color:var(--ink-subtle)}
.player-events{grid-column:1/-1;width:100%;margin-top:2rpx;padding-top:8rpx;border-top:1rpx solid var(--line)}.player-event{display:grid;grid-template-columns:minmax(0,1fr) auto auto;align-items:center;gap:8rpx;padding:8rpx 0;color:var(--ink-subtle);font-size:20rpx}.event-name{overflow:hidden;color:var(--ink);white-space:nowrap;text-overflow:ellipsis}.event-meta{white-space:nowrap}
.player-avatar{width:84rpx;height:84rpx;flex:none;border-radius:50%;background:var(--brand-soft)}
.player-avatar.fallback{display:flex;align-items:center;justify-content:center;color:var(--brand-strong);font-size:30rpx;font-weight:700}
.next-line{overflow:hidden;color:var(--brand-strong);font-size:21rpx;white-space:nowrap;text-overflow:ellipsis}.next-line.muted{color:var(--ink-subtle)}
.chevron{color:var(--ink-subtle);font-size:34rpx}
.participation-page.theme-daylight{
  padding-bottom:calc(126rpx + env(safe-area-inset-bottom));
  background:#f5f1e6;
}
.daylight-page-state{
  padding:62rpx 24rpx 0;
}
