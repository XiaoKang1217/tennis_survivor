.ledger-page{min-height:100vh;padding-bottom:50rpx;background:var(--canvas);color:var(--ink)}
.ledger-head{min-height:82rpx;padding-right:22rpx;padding-left:22rpx;display:grid;grid-template-columns:54rpx 1fr 54rpx;align-items:center;border-bottom:1rpx solid var(--line);background:var(--surface);box-sizing:content-box}.ledger-head>view{display:flex;align-items:center}.ledger-head>text{text-align:center;font-size:28rpx;font-weight:800}
.filter-card,.ledger-card{margin:20rpx 22rpx 0;padding:22rpx;border:1rpx solid var(--line);border-radius:22rpx;background:var(--surface)}
.direction-tabs{display:grid;grid-template-columns:repeat(3,1fr);gap:8rpx}.direction-tabs>view{height:62rpx;display:flex;align-items:center;justify-content:center;border-radius:13rpx;background:var(--canvas-subtle);color:var(--ink-subtle);font-size:22rpx}.direction-tabs>view.active{background:var(--brand-strong);color:#fff;font-weight:750}
.date-filters{margin-top:16rpx;display:grid;grid-template-columns:1fr 28rpx 1fr 66rpx;align-items:center;gap:8rpx}.date-filters>text{text-align:center;color:var(--ink-muted);font-size:18rpx}.date-filters picker>view{height:72rpx;padding:0 14rpx;display:flex;flex-direction:column;align-items:flex-start;justify-content:center;border:1rpx solid var(--line);border-radius:12rpx;box-sizing:border-box}.date-filters picker text:first-child{color:var(--ink-muted);font-size:16rpx}.date-filters picker text:last-child{margin-top:3rpx;color:var(--ink);font-size:19rpx}.clear-date{color:var(--brand-strong);font-size:19rpx;text-align:center}.clear-date.disabled{color:var(--ink-muted)}
.ledger-state{padding:100rpx 24rpx}.ledger-row{min-height:98rpx;display:flex;align-items:center;justify-content:space-between;gap:20rpx;border-bottom:1rpx solid var(--line)}.ledger-row:last-child{border-bottom:0}.ledger-row>view{display:flex;flex-direction:column}.ledger-row>view:first-child{min-width:0}.ledger-row>view:first-child text:first-child{color:var(--ink);font-size:23rpx;font-weight:650}.ledger-row>view text:last-child{margin-top:5rpx;color:var(--ink-muted);font-size:17rpx}.ledger-row>view:last-child{flex:none;align-items:flex-end}.ledger-row>view:last-child text:first-child{font-size:26rpx;font-weight:800}.income{color:#11a36a}.expense{color:#df5b4b}
.pagination{margin:22rpx;display:grid;grid-template-columns:1fr 120rpx 1fr;align-items:center;gap:14rpx}.pagination button{height:66rpx;margin:0;padding:0;border:1rpx solid var(--line);border-radius:13rpx;background:var(--surface);color:var(--brand-strong);font-size:21rpx;line-height:64rpx}.pagination button[disabled]{color:var(--ink-muted);background:var(--surface-subtle)}.pagination text{text-align:center;color:var(--ink-subtle);font-size:19rpx}
