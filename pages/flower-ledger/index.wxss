.ledger-page{min-height:100vh;padding-bottom:50rpx;background:var(--canvas);color:var(--ink)}
.ledger-head{min-height:82rpx;padding-right:22rpx;padding-left:22rpx;display:grid;grid-template-columns:54rpx 1fr 54rpx;align-items:center;border-bottom:1rpx solid var(--line);background:var(--surface);box-sizing:content-box}.ledger-head>view{display:flex;align-items:center}.ledger-head>text{text-align:center;font-size:28rpx;font-weight:800}
.filter-card,.ledger-card{margin:20rpx 22rpx 0;padding:22rpx;border:1rpx solid var(--line);border-radius:22rpx;background:var(--surface)}
.direction-tabs{display:grid;grid-template-columns:repeat(3,1fr);gap:8rpx}.direction-tabs>view{height:62rpx;display:flex;align-items:center;justify-content:center;border-radius:13rpx;background:var(--canvas-subtle);color:var(--ink-subtle);font-size:22rpx}.direction-tabs>view.active{background:var(--brand-strong);color:#fff;font-weight:750}
.date-filter-head{margin-top:18rpx;display:flex;align-items:center;justify-content:space-between}.date-filter-head>text{color:var(--ink-subtle);font-size:19rpx;font-weight:650}.clear-date{min-height:34rpx;display:flex;align-items:center;color:var(--brand-strong);font-size:19rpx}.clear-date.disabled{color:var(--ink-muted)}
.date-filters{margin-top:10rpx;display:grid;grid-template-columns:minmax(0,1fr) 32rpx minmax(0,1fr);align-items:center;gap:8rpx}.date-separator{text-align:center;color:var(--ink-muted);font-size:20rpx}.date-field{height:76rpx;padding:0 16rpx;display:flex;align-items:center;justify-content:space-between;gap:10rpx;border:1rpx solid var(--line);border-radius:14rpx;background:var(--canvas-subtle);box-sizing:border-box}.date-field text{font-size:19rpx;line-height:1}.date-field text:first-child{color:var(--ink-muted)}.date-field text:last-child{color:var(--ink);font-weight:650}
.ledger-state{padding:100rpx 24rpx}.ledger-row{min-height:98rpx;padding:17rpx 0;display:flex;flex-direction:column;justify-content:center;gap:8rpx;border-bottom:1rpx solid var(--line);box-sizing:border-box}.ledger-row:last-child{border-bottom:0}.ledger-row-primary,.ledger-row-secondary{display:flex;align-items:center;justify-content:space-between;gap:20rpx}.ledger-row-primary text:first-child{min-width:0;color:var(--ink);font-size:23rpx;font-weight:650;line-height:30rpx}.ledger-row-primary text:last-child{flex:none;font-size:26rpx;font-weight:800;line-height:30rpx}.ledger-row-secondary text{color:var(--ink-muted);font-size:17rpx;line-height:22rpx}.income{color:#11a36a}.expense{color:#df5b4b}
.pagination{width:calc(100% - 44rpx);margin:22rpx auto 0;display:grid;grid-template-columns:minmax(0,1fr) 120rpx minmax(0,1fr);align-items:center;gap:14rpx;box-sizing:border-box}.pagination .page-button{width:100%;min-width:0;height:66rpx;margin:0;padding:0;display:flex;align-items:center;justify-content:center;border:1rpx solid var(--line);border-radius:13rpx;background:var(--surface);color:var(--brand-strong);font-size:21rpx;line-height:1;box-sizing:border-box}.pagination .page-button::after{display:none}.pagination .page-button[disabled]{color:var(--ink-muted);background:var(--surface-subtle)}.pagination>text{text-align:center;color:var(--ink-subtle);font-size:19rpx;line-height:66rpx}
