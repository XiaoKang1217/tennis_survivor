.scores-page { position:relative; width:100%; max-width:100%; padding-bottom:calc(138rpx + env(safe-area-inset-bottom)); overflow-x:hidden; background:var(--canvas); box-sizing:border-box; }
.page-head,.controls,.score-list { width:100%; max-width:100%; overflow-x:hidden; box-sizing:border-box; }
.page-head { background:var(--surface); border-bottom:1rpx solid var(--line); }
.title-row { min-height:112rpx; padding:10rpx 160rpx 14rpx; display:flex; align-items:flex-end; justify-content:center; box-sizing:border-box; }
.title-copy { min-width:0; flex:1; display:flex; align-items:center; justify-content:center; }
.title { color:var(--ink); font-size:34rpx; line-height:1.2; font-weight:750; white-space:nowrap; }
.module-nav { width:100%; min-height:90rpx; display:flex; border-top:1rpx solid var(--line); box-sizing:border-box; }
.module { position:relative; flex:1 1 25%; width:25%; min-width:0; min-height:88rpx; margin:0; padding:8rpx 3rpx 14rpx; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:5rpx; overflow:hidden; background:transparent; color:var(--ink-subtle); font-size:24rpx; white-space:nowrap; box-sizing:border-box; }
.module.active { color:var(--brand-strong); font-weight:650; }
.module.active::after { content:''; position:absolute; left:24rpx; right:24rpx; bottom:0; height:4rpx; border-radius:4rpx; background:var(--brand); }
.controls { background:var(--surface); }
.search-row { width:100%; min-height:104rpx; padding:10rpx 24rpx; display:flex; gap:12rpx; border-bottom:1rpx solid var(--line); box-sizing:border-box; }
.search-box { min-width:0; min-height:84rpx; padding:0 18rpx; flex:1; display:flex; align-items:center; gap:12rpx; border:1rpx solid var(--line-strong); border-radius:18rpx; background:var(--surface-subtle); color:var(--ink-subtle); box-sizing:border-box; }
.search-box input { flex:1; min-width:0; height:82rpx; color:var(--ink); font-size:28rpx; }
.filter-action { flex:0 0 132rpx; min-height:84rpx; margin:0; padding:0 12rpx; display:flex; align-items:center; justify-content:center; gap:7rpx; border:1rpx solid var(--line-strong); border-radius:18rpx; background:var(--surface); color:var(--brand-strong); font-size:24rpx; box-sizing:border-box; }
.date-switcher { width:100%; min-height:112rpx; padding:8rpx 22rpx; display:flex; align-items:center; border-bottom:1rpx solid var(--line); box-sizing:border-box; }
.date-arrow { width:88rpx; height:88rpx; margin:0; padding:0; display:flex; align-items:center; justify-content:center; background:transparent; }
.date-label { min-width:0; flex:1; display:flex; flex-direction:column; align-items:center; gap:2rpx; color:var(--ink); font-size:27rpx; font-weight:650; }
.date-picker { min-width:0; flex:1; }
.date-caption { color:var(--ink-subtle); font-size:24rpx; font-weight:400; }
.quick-filters { width:100%; padding:14rpx 22rpx 18rpx; display:flex; gap:8rpx; box-sizing:border-box; }
.quick-filter { flex:1 1 25%; width:25%; min-width:0; min-height:78rpx; margin:0; padding:0 3rpx; display:flex; align-items:center; justify-content:center; overflow:hidden; border:1rpx solid var(--line); border-radius:15rpx; background:var(--surface); color:var(--ink-subtle); font-size:24rpx; white-space:nowrap; box-sizing:border-box; }
.quick-filter.selected { border-color:var(--brand); background:var(--brand); color:#fff; font-weight:650; }
.session-notice,.transport-notice { min-height:64rpx; padding:11rpx 28rpx; display:flex; align-items:center; gap:10rpx; box-sizing:border-box; color:var(--ink-muted); font-size:24rpx; line-height:1.45; }
.session-notice { background:var(--brand-soft); color:var(--brand-strong); }
.transport-notice { background:var(--surface-subtle); }
.transport-notice.state-reconnecting { background:var(--brand-soft); color:var(--warning); }
.transport-notice.state-offline { background:var(--surface-subtle); color:var(--danger); }
.freshness-bar { min-height:58rpx; padding:8rpx 28rpx; display:flex; align-items:center; gap:9rpx; background:var(--surface); border-top:1rpx solid var(--line); color:var(--ink-muted); font-size:21rpx; box-sizing:border-box; }
.freshness-dot { width:11rpx; height:11rpx; flex:none; border-radius:50%; background:var(--success); box-shadow:0 0 0 6rpx rgba(32,166,106,.10); }
.freshness-dot.unavailable { background:var(--danger); box-shadow:none; }
.freshness-time { color:var(--ink-muted); font-variant-numeric:tabular-nums; }
.data-notice-wrap { padding:10rpx 22rpx 0; }
.page-state { padding:50rpx 24rpx; }
.score-list { padding:12rpx 22rpx 34rpx; }
.date-group-head { min-height:68rpx; padding:0 4rpx 12rpx; display:flex; align-items:center; justify-content:space-between; }
.date-group-head > view { display:flex; flex-direction:column; gap:2rpx; }
.date-group-title { color:var(--ink); font-size:27rpx; font-weight:700; }
.date-group-caption { color:var(--ink-subtle); font-size:24rpx; }
.sort-action { min-height:72rpx; margin:0; padding:0; display:flex; align-items:center; gap:4rpx; background:transparent; color:var(--ink-subtle); font-size:24rpx; }
.tournament-block { margin-bottom:20rpx; overflow:hidden; border:1rpx solid var(--line); border-radius:26rpx; background:var(--surface); box-shadow:0 10rpx 30rpx rgba(40,85,120,.05); }
.tournament-head { width:100%; min-height:138rpx; margin:0; padding:18rpx 20rpx; display:flex; gap:16rpx; align-items:center; border-bottom:1rpx solid rgba(31,78,112,.08); background:var(--brand-soft); text-align:left; box-sizing:border-box; }
.surface-hard .tournament-head { background:var(--brand-soft); }
.surface-clay .tournament-head { background:rgba(217,45,32,.10); }
.surface-grass .tournament-head { background:rgba(32,166,106,.10); }
.surface-neutral .tournament-head { background:var(--surface-subtle); }
.tournament-logo-group { flex:0 0 86rpx; width:86rpx; display:flex; align-items:center; gap:8rpx; }
.tournament-logo-group.is-joint { flex-basis:148rpx; width:148rpx; }
.tournament-logo-box { flex:0 0 86rpx; width:86rpx; height:86rpx; display:flex; flex-direction:column; align-items:center; justify-content:center; overflow:hidden; border:2rpx solid rgba(255,255,255,.94); border-radius:19rpx; background:var(--surface); color:var(--ink); box-shadow:0 3rpx 12rpx rgba(31,78,112,.10); box-sizing:border-box; }
.tournament-logo-group.is-joint .tournament-logo-box { flex-basis:70rpx; width:70rpx; height:78rpx; border-radius:16rpx; }
.tournament-logo-box image { width:100%; height:100%; display:block; }
.tournament-logo-box.logo-atp { background:var(--brand-strong); }
.tournament-logo-box text:first-child { max-width:76rpx; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; font-size:20rpx; font-style:italic; font-weight:800; }
.tournament-logo-box text:last-child { max-width:78rpx; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; color:var(--ink-muted); font-size:18rpx; font-weight:700; }
.tournament-copy { min-width:0; flex:1; display:flex; flex-direction:column; gap:5rpx; }
.tournament-name { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; color:var(--ink); font-size:32rpx; font-weight:700; }
.tournament-meta,.tournament-venue { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; color:var(--ink-muted); font-size:24rpx; }
.tournament-venue { color:var(--ink-subtle); }
.collapse-action { flex:0 0 52rpx; width:52rpx; height:52rpx; margin-left:auto; display:flex; align-items:center; justify-content:center; border-radius:50%; background:rgba(255,255,255,.68); }
.tournament-logo-box image { transform:none; }
.court-block + .court-block { border-top:1rpx solid var(--line); }
.court-head { position:relative; width:100%; min-height:86rpx; margin:0; padding:12rpx 22rpx; display:flex; align-items:center; gap:14rpx; border-top:1rpx solid rgba(31,78,112,.06); border-bottom:1rpx solid var(--line); background:linear-gradient(90deg,var(--surface-subtle) 0%,var(--surface) 78%); color:var(--ink-muted); font-size:24rpx; box-sizing:border-box; }
.court-identity { min-width:0; flex:1; display:flex; align-items:center; gap:13rpx; }
.court-accent { flex:0 0 7rpx; width:7rpx; height:38rpx; border-radius:8rpx; background:linear-gradient(180deg,var(--brand),var(--brand-strong)); box-shadow:0 0 0 7rpx rgba(51,156,255,.08); }
.court-identity text { min-width:0; flex:1; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; color:var(--ink-muted); font-weight:700; }
.court-count { flex:none; padding:5rpx 11rpx; border-radius:999rpx; background:var(--canvas); color:var(--ink-subtle); font-size:20rpx; white-space:nowrap; }
.matches { background:var(--surface); }
.load-more { min-height:78rpx; margin:-2rpx 22rpx 30rpx; display:flex; align-items:center; justify-content:center; border:1rpx solid var(--line-strong); border-radius:18rpx; background:var(--surface); color:var(--ink-muted); font-size:23rpx; box-sizing:border-box; }
.filter-backdrop { position:fixed; z-index:50; inset:0; display:flex; align-items:flex-end; background:rgba(18,42,62,.28); }
.filter-sheet { width:100%; padding:28rpx 28rpx calc(32rpx + env(safe-area-inset-bottom)); border-radius:36rpx 36rpx 0 0; background:var(--surface); box-shadow:0 -20rpx 60rpx rgba(26,65,94,.16); box-sizing:border-box; }
.filter-sheet-head { display:flex; align-items:center; justify-content:space-between; color:var(--ink); font-size:29rpx; font-weight:700; }
.sheet-close { width:88rpx; height:88rpx; margin:0; padding:0; display:flex; align-items:center; justify-content:center; border-radius:50%; background:var(--surface-subtle); }
.filter-group { margin-top:26rpx; }
.filter-group-title { display:block; margin-bottom:14rpx; color:var(--ink); font-size:24rpx; font-weight:700; }
.filter-options { display:flex; flex-wrap:wrap; gap:12rpx; }
.filter-option { min-width:132rpx; min-height:68rpx; padding:0 22rpx; display:flex; align-items:center; justify-content:center; border:1rpx solid var(--line-strong); border-radius:16rpx; background:var(--surface-subtle); color:var(--ink-muted); font-size:23rpx; box-sizing:border-box; }
.filter-option.selected { border-color:var(--brand); background:var(--brand-soft); color:var(--brand-strong); font-weight:700; }
.filter-sheet-actions { margin-top:34rpx; display:grid; grid-template-columns:160rpx minmax(0,1fr); gap:14rpx; }
.filter-sheet-reset,.filter-sheet-done { min-height:88rpx; margin:0; display:flex; align-items:center; justify-content:center; border-radius:18rpx; font-size:25rpx; font-weight:650; box-sizing:border-box; }
.filter-sheet-reset { border:1rpx solid var(--line-strong); background:var(--surface); color:var(--ink-muted); }
.filter-sheet-done { background:var(--brand); color:#fff; }

