.legal-page{min-height:100vh;background:var(--canvas);color:var(--ink)}
.legal-head{padding-left:28rpx;padding-right:28rpx;padding-bottom:22rpx;display:flex;align-items:center;gap:18rpx;background:var(--surface);border-bottom:1rpx solid var(--line);box-sizing:content-box}
.legal-back{width:64rpx;height:64rpx;flex:0 0 64rpx;display:flex;align-items:center;justify-content:center;border-radius:50%;background:var(--surface-subtle)}
.legal-title-wrap{min-width:0;display:flex;flex-direction:column;gap:4rpx}
.legal-kicker{color:var(--ink-subtle);font-size:19rpx;font-weight:700;letter-spacing:3rpx}
.legal-title{color:var(--ink-strong);font-size:36rpx;font-weight:800;line-height:1.2}
.legal-subtitle{color:var(--ink-subtle);font-size:21rpx;line-height:1.35}
.legal-scroll{height:calc(100vh - 162rpx)}
.legal-meta{margin:24rpx 24rpx 0;padding:20rpx 22rpx;display:flex;flex-direction:column;gap:8rpx;border:1rpx solid var(--line);border-radius:18rpx;background:var(--surface);color:var(--ink-subtle);font-size:22rpx;line-height:1.35}
.legal-official{margin:18rpx 24rpx 0;padding:22rpx;display:flex;align-items:center;justify-content:space-between;gap:14rpx;border:1rpx solid var(--brand-soft);border-radius:18rpx;background:var(--brand-wash)}
.legal-official>view{min-width:0;display:flex;flex-direction:column;gap:5rpx}
.legal-official text:first-child{color:var(--brand-strong);font-size:25rpx;font-weight:760}
.legal-official text:last-child{color:var(--ink-subtle);font-size:20rpx;line-height:1.35}
.legal-section{margin:20rpx 24rpx 0;padding:26rpx 24rpx;border:1rpx solid var(--line);border-radius:20rpx;background:var(--surface)}
.legal-section-title{display:block;margin-bottom:14rpx;color:var(--ink-strong);font-size:28rpx;font-weight:800;line-height:1.32}
.legal-paragraph{display:block;margin-top:13rpx;color:var(--ink-muted);font-size:24rpx;line-height:1.72}
.legal-bottom-space{height:44rpx}
