[Unit]
Description=LuWang live tennis score cache and SSE service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=luwang-live
Group=luwang-live
WorkingDirectory=/opt/luwang-live-score/current
EnvironmentFile=/etc/luwang-live-score.env
ExecStart=/usr/bin/node src/server.mjs
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/luwang-live-score
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
